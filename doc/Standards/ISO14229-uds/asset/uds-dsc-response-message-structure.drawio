        <mxCell id="d12" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2e7d32;fontSize=9;align=center;verticalAlign=middle;fontColor=#263238;fontFamily=DejaVu Sans;fontStyle=1;" value="record byte #1&#10;P2Server_max&#10;high byte · SPREC_P2SMH"><mxGeometry x="400" y="166" width="124" height="48" as="geometry" /></mxCell>
        <mxCell id="d13" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2e7d32;fontSize=9;align=center;verticalAlign=middle;fontColor=#263238;fontFamily=DejaVu Sans;fontStyle=1;" value="record byte #2&#10;P2Server_max&#10;low byte · SPREC_P2SML"><mxGeometry x="528" y="166" width="124" height="48" as="geometry" /></mxCell>
        <mxCell id="d14" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ede7f6;strokeColor=#5e35b1;fontSize=9;align=center;verticalAlign=middle;fontColor=#263238;fontFamily=DejaVu Sans;fontStyle=1;" value="record byte #3&#10;P2*Server_max&#10;high byte · SPREC_P2ESMH"><mxGeometry x="656" y="166" width="124" height="48" as="geometry" /></mxCell>
