  <diagram name="uds-dsc-response-message-structure" id="uds-dsc-response-message-structure">
    <mxGraphModel dx="985" dy="1642" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="960" pageHeight="410" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title / subtitle -->
        <mxCell id="d1" parent="1" vertex="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#14337a;fontFamily=DejaVu Sans;fontStyle=1;" value="DiagnosticSessionControl positive response — A_Data structure (Clause 9.2.3.1, Table 26)"><mxGeometry x="0" y="10" width="960" height="22" as="geometry" /></mxCell>
        <mxCell id="d2" parent="1" vertex="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#607d8b;fontFamily=DejaVu Sans;" value="Response = 0x50, the echoed diagnosticSessionType, then a 4-byte sessionParameterRecord carrying the timing parameters of the session just entered."><mxGeometry x="20" y="40" width="920" height="16" as="geometry" /></mxCell>

        <!-- Byte-level labels -->
        <mxCell id="d3" parent="1" vertex="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=9.5;fontColor=#90a4ae;fontFamily=DejaVu Sans;" value="A_Data byte #1"><mxGeometry x="40" y="62" width="150" height="14" as="geometry" /></mxCell>
        <mxCell id="d4" parent="1" vertex="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=9.5;fontColor=#90a4ae;fontFamily=DejaVu Sans;" value="A_Data byte #2"><mxGeometry x="200" y="62" width="190" height="14" as="geometry" /></mxCell>
        <mxCell id="d5" parent="1" vertex="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=9.5;fontColor=#90a4ae;fontFamily=DejaVu Sans;" value="A_Data bytes #3 … #6"><mxGeometry x="400" y="62" width="510" height="14" as="geometry" /></mxCell>

        <!-- Byte-level boxes -->
        <mxCell id="d6" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1565c0;fontSize=9.5;align=center;verticalAlign=middle;fontColor=#263238;fontFamily=DejaVu Sans;fontStyle=1;" value="DiagnosticSessionControl SID&#10;0x50&#10;DSCPR · M (mandatory)"><mxGeometry x="40" y="80" width="150" height="52" as="geometry" /></mxCell>
        <mxCell id="d7" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#f26f21;fontSize=9.5;align=center;verticalAlign=middle;fontColor=#263238;fontFamily=DejaVu Sans;fontStyle=1;" value="diagnosticSessionType&#10;0x00 – 0xFF&#10;LEV_DS_ · M — echo of bits 6-0 of the request"><mxGeometry x="200" y="80" width="190" height="52" as="geometry" /></mxCell>
        <mxCell id="d8" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2e7d32;fontSize=9.5;align=center;verticalAlign=middle;fontColor=#263238;fontFamily=DejaVu Sans;fontStyle=1;" value="sessionParameterRecord — 4 bytes&#10;SPREC_DATA_1 … DATA_m, each 0x00 – 0xFF&#10;M — session-specific parameter values reported by the server (Table 27)"><mxGeometry x="400" y="80" width="510" height="52" as="geometry" /></mxCell>

        <!-- Connectors down to the record expansion -->
        <mxCell id="d9" parent="1" edge="1" style="endArrow=none;html=1;strokeColor=#2e7d32;dashed=1;" value=""><mxGeometry relative="1" as="geometry"><mxPoint x="400" y="132" as="sourcePoint" /><mxPoint x="400" y="164" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="d10" parent="1" edge="1" style="endArrow=none;html=1;strokeColor=#2e7d32;dashed=1;" value=""><mxGeometry relative="1" as="geometry"><mxPoint x="910" y="132" as="sourcePoint" /><mxPoint x="910" y="164" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="d11" parent="1" vertex="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=9;fontColor=#2e7d32;fontFamily=DejaVu Sans;fontStyle=2;" value="sessionParameterRecord expanded (Clause 9.2.3.2, Table 28)"><mxGeometry x="400" y="144" width="510" height="14" as="geometry" /></mxCell>

