        <mxCell id="t5" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cfd8dc;fontSize=9.5;align=left;verticalAlign=middle;fontColor=#263238;fontFamily=DejaVu Sans;spacingLeft=10;" value="0 ms"><mxGeometry x="740" y="286" width="70" height="32" as="geometry" /></mxCell>
