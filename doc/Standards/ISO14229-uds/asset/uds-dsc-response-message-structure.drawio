        <mxCell id="d18" parent="1" vertex="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#263238;fontFamily=DejaVu Sans;" value="Total positive response = 6 bytes: 0x50 + diagnosticSessionType + 4 record bytes (Table 26). The request that triggered it was only 2 bytes."><mxGeometry x="20" y="368" width="920" height="16" as="geometry" /></mxCell>
