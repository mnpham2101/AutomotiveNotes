        <!-- Note -->
        <mxCell id="d16" parent="1" vertex="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#263238;fontFamily=DejaVu Sans;" value="Both parameters are 2-byte unsigned values, high byte first. They are response-timing budgets for the session just activated — not the session lifetime."><mxGeometry x="20" y="228" width="920" height="16" as="geometry" /></mxCell>
        <mxCell id="d17" parent="1" vertex="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#263238;fontFamily=DejaVu Sans;fontStyle=1;" value="sessionParameterRecord content (Clause 9.2.3.2, Table 29)"><mxGeometry x="20" y="244" width="920" height="16" as="geometry" /></mxCell>

