  <diagram name="uds-dtc-status-byte" id="uds-dtc-status-byte">
    <mxGraphModel dx="985" dy="1642" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="960" pageHeight="340" math="0" shadow="0">
      <root>
        <mxCell id="0" />
