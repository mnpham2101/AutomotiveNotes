        <mxCell id="m22" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#f26f21;fontSize=11;align=left;verticalAlign=middle;fontColor=#263238;fontFamily=DejaVu Sans;spacingLeft=10;" value="programmingSession (PRGS)"><mxGeometry x="110" y="508" width="360" height="32" as="geometry" /></mxCell>

