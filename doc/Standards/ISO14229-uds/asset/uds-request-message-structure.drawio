        <!-- Title / subtitle -->
        <mxCell id="m1" parent="1" vertex="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#14337a;fontFamily=DejaVu Sans;fontStyle=1;" value="Request message — A_Data structure (Clause 9.2.2.1, Table 24)"><mxGeometry x="0" y="10" width="960" height="22" as="geometry" /></mxCell>
        <mxCell id="m2" parent="1" vertex="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#607d8b;fontFamily=DejaVu Sans;" value="DiagnosticSessionControl request = 2 bytes of A_Data: Service ID (SID) followed by the sub-function byte."><mxGeometry x="20" y="36" width="920" height="16" as="geometry" /></mxCell>

        <!-- Byte-level labels -->
        <mxCell id="m3" parent="1" vertex="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=9.5;fontColor=#90a4ae;fontFamily=DejaVu Sans;" value="A_Data byte #1"><mxGeometry x="250" y="60" width="150" height="14" as="geometry" /></mxCell>
        <mxCell id="m4" parent="1" vertex="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=9.5;fontColor=#90a4ae;fontFamily=DejaVu Sans;" value="A_Data byte #2"><mxGeometry x="450" y="60" width="350" height="14" as="geometry" /></mxCell>

        <!-- Byte-level boxes -->
        <mxCell id="m5" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1565c0;fontSize=10;align=center;verticalAlign=middle;fontColor=#263238;fontFamily=DejaVu Sans;fontStyle=1;" value="0x10&#10;SID: DiagnosticSessionControl (DSC)"><mxGeometry x="250" y="78" width="150" height="48" as="geometry" /></mxCell>
        <mxCell id="m6" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#f26f21;fontSize=10;align=center;verticalAlign=middle;fontColor=#263238;fontFamily=DejaVu Sans;fontStyle=1;" value="diagnosticSessionType&#10;0x00 – 0xFF&#10;&lt;i style=&quot;font-size:8.5px;font-weight:normal;color:#607d8b&quot;&gt;bit 7 = SPRMIB · bits 6–0 = session value&lt;/i&gt;"><mxGeometry x="450" y="78" width="350" height="48" as="geometry" /></mxCell>

        <!-- Connectors from byte #2 down to bit-level expansion -->
        <mxCell id="m7" parent="1" edge="1" style="endArrow=none;html=1;strokeColor=#f26f21;dashed=1;" value=""><mxGeometry relative="1" as="geometry"><mxPoint x="472" y="126" as="sourcePoint" /><mxPoint x="472" y="162" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m8" parent="1" edge="1" style="endArrow=none;html=1;strokeColor=#f26f21;dashed=1;" value=""><mxGeometry relative="1" as="geometry"><mxPoint x="647" y="126" as="sourcePoint" /><mxPoint x="647" y="162" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m9" parent="1" vertex="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=9;fontColor=#f26f21;fontFamily=DejaVu Sans;fontStyle=2;" value="byte #2 expanded into bits"><mxGeometry x="450" y="140" width="350" height="14" as="geometry" /></mxCell>

        <!-- Bit-level labels -->
        <mxCell id="m10" parent="1" vertex="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=9.5;fontColor=#90a4ae;fontFamily=DejaVu Sans;" value="bit 7"><mxGeometry x="450" y="164" width="44" height="14" as="geometry" /></mxCell>
        <mxCell id="m11" parent="1" vertex="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=9.5;fontColor=#90a4ae;fontFamily=DejaVu Sans;" value="bits 6 – 0"><mxGeometry x="494" y="164" width="306" height="14" as="geometry" /></mxCell>

        <!-- Bit-level boxes -->
        <mxCell id="m12" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eceff1;strokeColor=#90a4ae;fontSize=9.5;align=center;verticalAlign=middle;fontColor=#263238;fontFamily=DejaVu Sans;fontStyle=1;" value="SPRMIB"><mxGeometry x="450" y="180" width="44" height="44" as="geometry" /></mxCell>
        <mxCell id="m13" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2e7d32;fontSize=10;align=center;verticalAlign=middle;fontColor=#263238;fontFamily=DejaVu Sans;fontStyle=1;" value="bits 6 – 0"><mxGeometry x="494" y="180" width="306" height="44" as="geometry" /></mxCell>

        <!-- Note -->
        <mxCell id="m14" parent="1" vertex="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#263238;fontFamily=DejaVu Sans;" value="diagnosticSessionType (Table 24) is the whole sub-function byte. Bit 7 = SPRMIB toggles whether the positive response is"><mxGeometry x="20" y="232" width="920" height="16" as="geometry" /></mxCell>
        <mxCell id="m14b" parent="1" vertex="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#263238;fontFamily=DejaVu Sans;" value="suppressed — it does not change which session is requested. Bits 6-0 carry the session value the client is requesting."><mxGeometry x="20" y="246" width="920" height="16" as="geometry" /></mxCell>
        <mxCell id="m14c" parent="1" vertex="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#263238;fontFamily=DejaVu Sans;" value="Table 25 (below) lists session values assuming SPRMIB = 0; with SPRMIB = 1, add 0x80 to get the actual byte, e.g. 0x81."><mxGeometry x="20" y="259" width="920" height="16" as="geometry" /></mxCell>

        <!-- Worked example -->
        <mxCell id="ex1" parent="1" vertex="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=10.5;fontStyle=1;fontFamily=DejaVu Sans;fontColor=#263238;" value="Worked example — composing diagnosticSessionType (SPRMIB | session value)"><mxGeometry x="20" y="284" width="920" height="16" as="geometry" /></mxCell>

        <mxCell id="ex2" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2e7d32;fontSize=10.5;align=center;verticalAlign=middle;fontColor=#263238;fontFamily=DejaVu Sans Mono, Consolas;fontStyle=1;" value="0000 0001"><mxGeometry x="20" y="302" width="190" height="28" as="geometry" /></mxCell>
        <mxCell id="ex3" parent="1" vertex="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontStyle=1;fontFamily=DejaVu Sans;fontColor=#263238;" value="= 0x01"><mxGeometry x="222" y="300" width="120" height="16" as="geometry" /></mxCell>
        <mxCell id="ex4" parent="1" vertex="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=9;fontFamily=DejaVu Sans;fontColor=#607d8b;" value="SPRMIB=0 (positive response expected) · session value = 0x01 (defaultSession) → diagnosticSessionType = 0x01"><mxGeometry x="222" y="316" width="700" height="14" as="geometry" /></mxCell>

        <mxCell id="ex5" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#f26f21;fontSize=10.5;align=center;verticalAlign=middle;fontColor=#263238;fontFamily=DejaVu Sans Mono, Consolas;fontStyle=1;" value="1000 0001"><mxGeometry x="20" y="336" width="190" height="28" as="geometry" /></mxCell>
        <mxCell id="ex6" parent="1" vertex="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontStyle=1;fontFamily=DejaVu Sans;fontColor=#263238;" value="= 0x81"><mxGeometry x="222" y="334" width="120" height="16" as="geometry" /></mxCell>
        <mxCell id="ex7" parent="1" vertex="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=9;fontFamily=DejaVu Sans;fontColor=#607d8b;" value="SPRMIB=1 (positive response suppressed) · session value = 0x01 (defaultSession) → diagnosticSessionType = 0x81"><mxGeometry x="222" y="350" width="700" height="14" as="geometry" /></mxCell>

        <mxCell id="ex8" parent="1" vertex="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#263238;fontFamily=DejaVu Sans;" value="diagnosticSessionType is the full byte the client sends (Table 24) — the same name Table 25 uses for its 7-bit session values assumes SPRMIB = 0."><mxGeometry x="20" y="374" width="920" height="16" as="geometry" /></mxCell>

        <mxCell id="m16" parent="1" vertex="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#263238;fontFamily=DejaVu Sans;fontStyle=1;" value="diagnosticSessionType field values (Clause 9.2.2.2, Table 25)"><mxGeometry x="20" y="398" width="920" height="16" as="geometry" /></mxCell>
        <mxCell id="m16b" parent="1" vertex="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=9;fontStyle=2;fontColor=#607d8b;fontFamily=DejaVu Sans;" value="— values below assume SPRMIB = 0; add 0x80 to each when SPRMIB = 1"><mxGeometry x="20" y="412" width="920" height="14" as="geometry" /></mxCell>

