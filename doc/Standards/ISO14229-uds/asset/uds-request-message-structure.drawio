        <mxCell id="m35" parent="1" vertex="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#263238;fontFamily=DejaVu Sans;" value="Each row is a value (or range of values) of the same 7-bit field — the ranges are not tied to any single bit position."><mxGeometry x="20" y="618" width="920" height="16" as="geometry" /></mxCell>
        <mxCell id="m36" parent="1" vertex="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#263238;fontFamily=DejaVu Sans;" value="Positive response echoes the same session value: 0x50 &lt;diagnosticSessionType&gt; [sessionParameterRecord] (Table 26) — SPRMIB is not echoed."><mxGeometry x="20" y="638" width="920" height="16" as="geometry" /></mxCell>

