        <mxCell id="e1" parent="1" vertex="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#14337a;fontFamily=DejaVu Sans;fontStyle=1;" value="testNotCompletedThisOperationCycle (bit 6) — adapted from Annex D.6, Figure D.10 and D.2.4, Figure D.9"><mxGeometry x="0" y="8" width="980" height="22" as="geometry" /></mxCell>
        <mxCell id="e2" parent="1" vertex="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#607d8b;fontFamily=DejaVu Sans;" value="Bit 6 clears the instant the counter first reaches either extreme in a cycle — that's what &quot;the test ran to completion&quot; means."><mxGeometry x="20" y="30" width="940" height="16" as="geometry" /></mxCell>

