        <!-- legend -->
        <mxCell id="e31" parent="1" vertex="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f26f21;strokeColor=none;fontColor=#ffffff;fontSize=8;fontStyle=1;align=center;verticalAlign=middle;" value="1"><mxGeometry x="20" y="350" width="16" height="16" as="geometry" /></mxCell>
        <mxCell id="e32" parent="1" vertex="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=9.5;fontColor=#263238;fontFamily=DejaVu Sans;" value="Counter reaches +127 (max) — the test just completed with a failed result: bit 0 sets 0→1 and bit 6 clears 1→0 together"><mxGeometry x="44" y="350" width="900" height="16" as="geometry" /></mxCell>

        <mxCell id="e33" parent="1" vertex="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f26f21;strokeColor=none;fontColor=#ffffff;fontSize=8;fontStyle=1;align=center;verticalAlign=middle;" value="2"><mxGeometry x="20" y="372" width="16" height="16" as="geometry" /></mxCell>
        <mxCell id="e34" parent="1" vertex="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=9.5;fontColor=#263238;fontFamily=DejaVu Sans;" value="Cycle 1 stops / Cycle 2 starts — the counter also resets to 0, same as bit 6 → 1, for the new cycle's not-yet-run test [key 8]; bit 0 stays retained"><mxGeometry x="44" y="372" width="900" height="16" as="geometry" /></mxCell>

        <mxCell id="e35" parent="1" vertex="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f26f21;strokeColor=none;fontColor=#ffffff;fontSize=8;fontStyle=1;align=center;verticalAlign=middle;" value="3"><mxGeometry x="20" y="394" width="16" height="16" as="geometry" /></mxCell>
        <mxCell id="e36" parent="1" vertex="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=9.5;fontColor=#263238;fontFamily=DejaVu Sans;" value="Counter reaches its minimum for the first time this cycle — same corroboration, now for a passed result: bit 0 resets 1→0 and bit 6 clears 1→0 together"><mxGeometry x="44" y="394" width="900" height="16" as="geometry" /></mxCell>

        <mxCell id="e37" parent="1" vertex="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=9.5;fontColor=#607d8b;fontFamily=DejaVu Sans;" value="Reaching either extreme is what &quot;ran to completion&quot; means — bit 6 doesn't care whether the result was a pass or a fail, only that a result exists."><mxGeometry x="20" y="424" width="940" height="16" as="geometry" /></mxCell>
        <mxCell id="e38" parent="1" vertex="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=8.5;fontColor=#90a4ae;fontFamily=DejaVu Sans;" value="Simplified — combines Annex D.6, Figure D.10 (keys 1, 3, 9) with Annex D.2.4, Figure D.9 (keys 9–12); whether testFailed is retained across the cycle boundary is manufacturer specific."><mxGeometry x="20" y="440" width="940" height="14" as="geometry" /></mxCell>
