        <mxCell id="e27" parent="1" edge="1" style="endArrow=none;html=1;strokeColor=#f26f21;dashed=1;" value=""><mxGeometry relative="1" as="geometry"><mxPoint x="580" y="108" as="sourcePoint" /><mxPoint x="580" y="330" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="e28" parent="1" vertex="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f26f21;strokeColor=none;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;" value="2"><mxGeometry x="571" y="99" width="18" height="18" as="geometry" /></mxCell>

