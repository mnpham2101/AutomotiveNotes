        <mxCell id="r18" parent="1" vertex="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#263238;fontFamily=DejaVu Sans;" value="A DID is a value of the whole 16-bit field — it names an object&#10;(e.g. VIN), never a bit position. Ranges are assigned in Table C.1."><mxGeometry x="530" y="168" width="410" height="46" as="geometry" /></mxCell>

        <!-- Note -->
        <mxCell id="r19" parent="1" vertex="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#263238;fontFamily=DejaVu Sans;" value="Each requested DID costs exactly 2 bytes; the client may repeat the same DID, and the server shall answer it as often as requested (Clause 10.2.2.1)."><mxGeometry x="20" y="226" width="920" height="16" as="geometry" /></mxCell>

