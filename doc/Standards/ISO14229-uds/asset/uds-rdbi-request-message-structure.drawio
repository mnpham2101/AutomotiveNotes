        <!-- Title / subtitle -->
        <mxCell id="r1" parent="1" vertex="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#14337a;fontFamily=DejaVu Sans;fontStyle=1;" value="ReadDataByIdentifier request — A_Data structure (Clause 10.2.2.1, Table 142)"><mxGeometry x="0" y="10" width="960" height="22" as="geometry" /></mxCell>
        <mxCell id="r2" parent="1" vertex="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#607d8b;fontFamily=DejaVu Sans;" value="Request = 1 byte Service ID followed by one or more 2-byte dataIdentifiers. This service has no sub-function byte (Clause 10.2.2.2)."><mxGeometry x="20" y="40" width="920" height="16" as="geometry" /></mxCell>

        <!-- Byte-level labels -->
