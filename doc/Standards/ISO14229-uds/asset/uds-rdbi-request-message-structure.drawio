        <!-- Footer notes -->
        <mxCell id="r42" parent="1" vertex="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#263238;fontFamily=DejaVu Sans;" value="Minimum request length is 3 bytes (SID + one DID); maximum is 1 + 2×n. A wrong length gives NRC 0x13 incorrectMessageLengthOrInvalidFormat (Figure 15)."><mxGeometry x="20" y="486" width="920" height="16" as="geometry" /></mxCell>
        <mxCell id="r43" parent="1" vertex="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#263238;fontFamily=DejaVu Sans;" value="The server may cap how many dataIdentifiers one request may carry — the limit is agreed between vehicle manufacturer and system supplier (Clause 10.2.1)."><mxGeometry x="20" y="504" width="920" height="16" as="geometry" /></mxCell>

