        <mxCell id="e1" parent="1" vertex="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#14337a;fontFamily=DejaVu Sans;fontStyle=1;" value="confirmedDTC &amp; DTCAgingCounter — adapted from Annex D.2.1, Table D.6, Figure D.4 and D.7 / Figure D.11"><mxGeometry x="0" y="8" width="980" height="22" as="geometry" /></mxCell>
