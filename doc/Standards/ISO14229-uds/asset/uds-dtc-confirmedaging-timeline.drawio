        <mxCell id="e47" parent="1" vertex="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f26f21;strokeColor=none;fontColor=#ffffff;fontSize=8;fontStyle=1;align=center;verticalAlign=middle;" value="1"><mxGeometry x="20" y="468" width="16" height="16" as="geometry" /></mxCell>
        <mxCell id="e48" parent="1" vertex="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=9.5;fontColor=#263238;fontFamily=DejaVu Sans;" value="Test fails the 1st time — bit 0 pulses 0→1→0; TripCounter increments 0→1; bit 5 latches 0→1 and never resets on its own"><mxGeometry x="44" y="468" width="900" height="16" as="geometry" /></mxCell>

        <mxCell id="e49" parent="1" vertex="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f26f21;strokeColor=none;fontColor=#ffffff;fontSize=8;fontStyle=1;align=center;verticalAlign=middle;" value="2"><mxGeometry x="20" y="490" width="16" height="16" as="geometry" /></mxCell>
        <mxCell id="e50" parent="1" vertex="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=9.5;fontColor=#263238;fontFamily=DejaVu Sans;" value="Test fails a 2nd time — bit 0 pulses again; TripCounter increments 1→2; confirmation threshold (3) not yet met, so bit 3 stays 0"><mxGeometry x="44" y="490" width="900" height="16" as="geometry" /></mxCell>

        <mxCell id="e51" parent="1" vertex="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f26f21;strokeColor=none;fontColor=#ffffff;fontSize=8;fontStyle=1;align=center;verticalAlign=middle;" value="3"><mxGeometry x="20" y="512" width="16" height="16" as="geometry" /></mxCell>
        <mxCell id="e52" parent="1" vertex="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=9.5;fontColor=#263238;fontFamily=DejaVu Sans;" value="Test fails a 3rd time — TripCounter reaches the confirmation threshold: bit 3 sets 0→1 and TripCounter resets to 0, in the same instant"><mxGeometry x="44" y="512" width="900" height="16" as="geometry" /></mxCell>

        <mxCell id="e53" parent="1" vertex="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f26f21;strokeColor=none;fontColor=#ffffff;fontSize=8;fontStyle=1;align=center;verticalAlign=middle;" value="4"><mxGeometry x="20" y="534" width="16" height="16" as="geometry" /></mxCell>
        <mxCell id="e54" parent="1" vertex="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=9.5;fontColor=#263238;fontFamily=DejaVu Sans;" value="DTCAgingCounter increments +1 at the end of each subsequent clean cycle; on reaching its threshold, bit 3 resets 1→0"><mxGeometry x="44" y="534" width="900" height="16" as="geometry" /></mxCell>

        <mxCell id="e55" parent="1" vertex="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=9.5;fontColor=#607d8b;fontFamily=DejaVu Sans;" value="confirmedDTC does not require testFailed to still be 1 — a DTC stays confirmed while the fault is currently absent [Table D.6]."><mxGeometry x="20" y="564" width="940" height="16" as="geometry" /></mxCell>
        <mxCell id="e56" parent="1" vertex="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=9.5;fontColor=#607d8b;fontFamily=DejaVu Sans;" value="Whether testFailedSinceLastClear resets when the aging threshold is met is unspecified — &quot;the responsibility of the vehicle manufacturer&quot; [Table D.8; Figure D.11, key 7]."><mxGeometry x="20" y="580" width="940" height="16" as="geometry" /></mxCell>
        <mxCell id="e57" parent="1" vertex="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=8.5;fontColor=#90a4ae;fontFamily=DejaVu Sans;" value="Simplified from Figure D.11 (Annex D.7) — the real figure also tracks bits 1, 2, 4 and 6, and uses a confirmation threshold of 1 with a 40-cycle aging threshold."><mxGeometry x="20" y="602" width="940" height="14" as="geometry" /></mxCell>
