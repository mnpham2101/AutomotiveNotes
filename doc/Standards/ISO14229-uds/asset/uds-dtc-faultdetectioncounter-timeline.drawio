        <!-- legend -->
        <mxCell id="e28pre" parent="1" vertex="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f26f21;strokeColor=none;fontColor=#ffffff;fontSize=8;fontStyle=1;align=center;verticalAlign=middle;" value="1"><mxGeometry x="20" y="373" width="16" height="16" as="geometry" /></mxCell>
        <mxCell id="e29pre" parent="1" vertex="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=9.5;fontColor=#263238;fontFamily=DejaVu Sans;" value="A run of passed samples has decremented the counter into negative territory; one failed sample jumps it straight above 0, not step by step [key 2]"><mxGeometry x="44" y="373" width="1100" height="16" as="geometry" /></mxCell>

        <mxCell id="e28" parent="1" vertex="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f26f21;strokeColor=none;fontColor=#ffffff;fontSize=8;fontStyle=1;align=center;verticalAlign=middle;" value="2"><mxGeometry x="20" y="395" width="16" height="16" as="geometry" /></mxCell>
        <mxCell id="e29" parent="1" vertex="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=9.5;fontColor=#263238;fontFamily=DejaVu Sans;" value="Counter reaches +127 (max) — fault fully matured — bits 0, 1 and 5 all set 0 → 1 together"><mxGeometry x="44" y="395" width="1100" height="16" as="geometry" /></mxCell>

        <mxCell id="e30" parent="1" vertex="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f26f21;strokeColor=none;fontColor=#ffffff;fontSize=8;fontStyle=1;align=center;verticalAlign=middle;" value="3"><mxGeometry x="20" y="417" width="16" height="16" as="geometry" /></mxCell>
        <mxCell id="e31" parent="1" vertex="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=9.5;fontColor=#263238;fontFamily=DejaVu Sans;" value="Counter falls back to its minimum — only bit 0 resets 1 → 0; bits 1 and 5 are untouched"><mxGeometry x="44" y="417" width="1100" height="16" as="geometry" /></mxCell>

        <mxCell id="e32" parent="1" vertex="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f26f21;strokeColor=none;fontColor=#ffffff;fontSize=8;fontStyle=1;align=center;verticalAlign=middle;" value="4"><mxGeometry x="20" y="439" width="16" height="16" as="geometry" /></mxCell>
        <mxCell id="e33" parent="1" vertex="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=9.5;fontColor=#263238;fontFamily=DejaVu Sans;" value="Cycle 1 stops / Cycle 2 starts — the new cycle's monitor hasn't run yet, so the counter restarts at 0 [key 8]; bit 1 resets 1 → 0 (this cycle only); bit 0 stays 0"><mxGeometry x="44" y="439" width="1100" height="16" as="geometry" /></mxCell>

        <mxCell id="e34" parent="1" vertex="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=9.5;fontColor=#607d8b;fontFamily=DejaVu Sans;" value="bit 5 (testFailedSinceLastClear) never resets on its own — only ClearDiagnosticInformation (0x14) clears it [Annex D.2]."><mxGeometry x="20" y="470" width="1140" height="16" as="geometry" /></mxCell>
        <mxCell id="e35" parent="1" vertex="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=8.5;fontColor=#90a4ae;fontFamily=DejaVu Sans;" value="Simplified from Figure D.10 (Annex D.6) — the real figure also tracks Test, Test Sample, pendingDTC, confirmedDTC and two more status bits."><mxGeometry x="20" y="486" width="1140" height="14" as="geometry" /></mxCell>
