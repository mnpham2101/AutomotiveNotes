        <!-- 3: sendKey -->
        <mxCell id="m3lbl" parent="1" vertex="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontStyle=1;fontFamily=DejaVu Sans;fontColor=#5e35b1;" value="3  sendKey"><mxGeometry x="135" y="206" width="300" height="16" as="geometry" /></mxCell>
        <mxCell id="m3sub" parent="1" vertex="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=8.5;fontFamily=DejaVu Sans;fontColor=#607d8b;" value="client → server · SID 0x27 &lt;type+1&gt; &lt;securityKey&gt; [Clause 9.4.2.1, Table 41]"><mxGeometry x="135" y="220" width="560" height="14" as="geometry" /></mxCell>
