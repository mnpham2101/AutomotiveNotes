        <!-- 5b: positive response, unlocked -->
        <mxCell id="m5blb" parent="1" vertex="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontStyle=1;fontFamily=DejaVu Sans;fontColor=#2e7d32;" value="5b  positive response (posRes)"><mxGeometry x="135" y="412" width="300" height="16" as="geometry" /></mxCell>
        <mxCell id="m5bsub" parent="1" vertex="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=8.5;fontFamily=DejaVu Sans;fontColor=#607d8b;" value="server → client · SID 0x67 &lt;type&gt;, no seed bytes [Clause 9.4.3.1, Table 44]"><mxGeometry x="135" y="426" width="560" height="14" as="geometry" /></mxCell>
        <mxCell id="m5b" parent="1" edge="1" style="endArrow=block;endFill=1;html=1;dashed=1;strokeColor=#2e7d32;" value="">
