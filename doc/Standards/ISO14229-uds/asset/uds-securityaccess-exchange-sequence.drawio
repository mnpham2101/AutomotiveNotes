            <mxPoint x="705" y="142" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- 2: seed positive response -->
        <mxCell id="m2lbl" parent="1" vertex="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontStyle=1;fontFamily=DejaVu Sans;fontColor=#2e7d32;" value="2  positive response — seed"><mxGeometry x="135" y="156" width="300" height="16" as="geometry" /></mxCell>
        <mxCell id="m2sub" parent="1" vertex="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=8.5;fontFamily=DejaVu Sans;fontColor=#607d8b;" value="server → client · SID 0x67 &lt;type&gt; &lt;securitySeed&gt; [Clause 9.4.3.1, Table 44]"><mxGeometry x="135" y="170" width="560" height="14" as="geometry" /></mxCell>
        <mxCell id="m2" parent="1" edge="1" style="endArrow=block;endFill=1;html=1;dashed=1;strokeColor=#2e7d32;" value="">
