        <mxCell id="t1" parent="1" vertex="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#14337a;fontFamily=DejaVu Sans;fontStyle=1;" value="Server-client security exchange — SecurityAccess seed/key sequence (Clause 9.4.1)"><mxGeometry x="0" y="10" width="960" height="22" as="geometry" /></mxCell>
        <mxCell id="t2" parent="1" vertex="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#607d8b;fontFamily=DejaVu Sans;" value="Two request/response pairs unlock one security level; an invalid key requires the client to restart from requestSeed (Annex I)."><mxGeometry x="20" y="34" width="900" height="16" as="geometry" /></mxCell>

        <!-- Lifeline heads -->
        <mxCell id="cHead" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1565c0;fontSize=12;fontStyle=1;fontFamily=DejaVu Sans;fontColor=#263238;align=center;verticalAlign=middle;" value="Client (tester)"><mxGeometry x="40" y="62" width="170" height="36" as="geometry" /></mxCell>
        <mxCell id="sHead" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1565c0;fontSize=12;fontStyle=1;fontFamily=DejaVu Sans;fontColor=#263238;align=center;verticalAlign=middle;" value="Server (ECU)"><mxGeometry x="620" y="62" width="170" height="36" as="geometry" /></mxCell>

