        <!-- divider -->
        <mxCell id="altDiv" parent="1" edge="1" style="endArrow=none;html=1;dashed=1;strokeColor=#90a4ae;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="40" y="406" as="sourcePoint" />
            <mxPoint x="920" y="406" as="targetPoint" />
