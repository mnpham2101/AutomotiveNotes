        <!-- note -->
        <mxCell id="note" parent="1" vertex="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#f26f21;size=20;fontSize=9.5;fontFamily=DejaVu Sans;fontColor=#263238;align=left;spacingLeft=10;spacingTop=6;verticalAlign=top;" value="&lt;b style=&quot;color:#e65100&quot;&gt;seed value = 0x00 00&lt;/b&gt;&lt;br&gt;embedded in posRes, for the security&lt;br&gt;level now unlocked [Clause 9.4.1]"><mxGeometry x="580" y="465" width="300" height="60" as="geometry" /></mxCell>

        <mxCell id="foot" parent="1" vertex="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontFamily=DejaVu Sans;fontColor=#263238;" value="An invalid key requires the client to restart the whole sequence from requestSeed (Clause 9.4.1, Annex I). Only one security level is&#10;active at a time — unlocking a new level deactivates whichever level was unlocked before (Clause 9.4.1)."><mxGeometry x="20" y="550" width="900" height="34" as="geometry" /></mxCell>

