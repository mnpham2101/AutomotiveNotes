        <mxCell id="m1sub" parent="1" vertex="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=8.5;fontFamily=DejaVu Sans;fontColor=#607d8b;" value="client → server · SID 0x27, sub-function = securityAccessType (odd) [Clause 9.4.2.1, Table 40]"><mxGeometry x="135" y="120" width="560" height="14" as="geometry" /></mxCell>
