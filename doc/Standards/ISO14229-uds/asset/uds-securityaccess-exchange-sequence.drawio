        <mxCell id="m4sub" parent="1" vertex="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=8.5;fontFamily=DejaVu Sans;fontColor=#607d8b;" value="vs. internally stored / calculated value;&#10;confirm validity and unlock client's&#10;access for that security level"><mxGeometry x="770" y="270" width="180" height="40" as="geometry" /></mxCell>

        <!-- alt frame -->
        <mxCell id="altFrame" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#90a4ae;dashed=1;verticalAlign=top;align=left;" value=""><mxGeometry x="40" y="320" width="880" height="220" as="geometry" /></mxCell>
        <mxCell id="altTab" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eceff1;strokeColor=#90a4ae;fontSize=10;fontStyle=1;fontFamily=DejaVu Sans;fontColor=#455a64;align=center;verticalAlign=middle;" value="alt"><mxGeometry x="40" y="320" width="54" height="20" as="geometry" /></mxCell>
        <mxCell id="altCond1" parent="1" vertex="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=9.5;fontFamily=DejaVu Sans;fontStyle=2;fontColor=#c62828;" value="[key invalid — false access attempt]"><mxGeometry x="104" y="322" width="400" height="16" as="geometry" /></mxCell>

        <!-- 5a: negative response -->
        <mxCell id="m5alb" parent="1" vertex="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontStyle=1;fontFamily=DejaVu Sans;fontColor=#c62828;" value="5a  negative response"><mxGeometry x="135" y="346" width="300" height="16" as="geometry" /></mxCell>
        <mxCell id="m5asub" parent="1" vertex="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=8.5;fontFamily=DejaVu Sans;fontColor=#607d8b;" value="server → client · NRC 0x7F 0x27 &lt;NRC&gt; [Clause 9.4.4, Table 46]"><mxGeometry x="135" y="360" width="560" height="14" as="geometry" /></mxCell>
        <mxCell id="m5a" parent="1" edge="1" style="endArrow=block;endFill=1;html=1;dashed=1;strokeColor=#c62828;" value="">
