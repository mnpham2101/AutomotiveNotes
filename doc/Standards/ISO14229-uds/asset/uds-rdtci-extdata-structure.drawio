        <mxCell id="e1" parent="1" vertex="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#14337a;fontFamily=DejaVu Sans;fontStyle=1;" value="ReadDTCInformation 0x06 — reportDTCExtDataRecordByDTCNumber (Clause 11.3.2 / 11.3.3, Table 276)"><mxGeometry x="0" y="10" width="960" height="22" as="geometry" /></mxCell>
        <mxCell id="e2" parent="1" vertex="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#607d8b;fontFamily=DejaVu Sans;" value="One DTC in (DTCMaskRecord); DTC+status echoed once, then a record repeats per DTCExtDataRecordNumber returned."><mxGeometry x="20" y="32" width="920" height="16" as="geometry" /></mxCell>

        <mxCell id="e3" parent="1" vertex="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#f26f21;fontFamily=DejaVu Sans;fontStyle=1;" value="Request (Table 259) — names one DTC and one record (or 0xFE/0xFF for all)"><mxGeometry x="20" y="54" width="700" height="14" as="geometry" /></mxCell>
        <mxCell id="e4" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1565c0;fontSize=9;align=center;verticalAlign=middle;fontColor=#263238;fontFamily=DejaVu Sans;" value="0x19"><mxGeometry x="20" y="74" width="70" height="38" as="geometry" /></mxCell>
