        <mxCell id="e15" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ede7f6;strokeColor=#5e35b1;fontSize=8;align=center;verticalAlign=middle;fontColor=#263238;fontFamily=DejaVu Sans;" value="extendedData bytes — manufacturer-defined, not part of ISO 14229-1"><mxGeometry x="488" y="152" width="434" height="28" as="geometry" /></mxCell>

        <mxCell id="e16" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f9fb;strokeColor=#cfd8dc;fontSize=9;align=left;verticalAlign=middle;spacingLeft=8;fontColor=#263238;fontFamily=DejaVu Sans Mono;" value="Example (11.3.5.8): 19 06 12 34 56 FF  →  59 06 | 12 34 56 24 | 05 17 | 10 79"><mxGeometry x="20" y="200" width="920" height="24" as="geometry" /></mxCell>

        <mxCell id="e17" parent="1" vertex="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=9.5;fontColor=#607d8b;fontFamily=DejaVu Sans;" value="DTC 0x123456, status 0x24, client asked for all records (0xFF): record 0x05 (warm-up counter) = 0x17, record 0x10 (fault-detection counter) = 0x79."><mxGeometry x="20" y="232" width="920" height="16" as="geometry" /></mxCell>
        <mxCell id="e18" parent="1" vertex="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=9.5;fontColor=#607d8b;fontFamily=DejaVu Sans;" value="Unlike a DTCSnapshot record, there's no dataIdentifier here — the DTCExtDataRecordNumber itself is the label, defined manufacturer to manufacturer."><mxGeometry x="20" y="250" width="920" height="16" as="geometry" /></mxCell>
