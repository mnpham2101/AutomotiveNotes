        <mxCell id="e8" parent="1" vertex="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#2e7d32;fontFamily=DejaVu Sans;fontStyle=1;" value="Positive response (Table 276)"><mxGeometry x="20" y="128" width="300" height="14" as="geometry" /></mxCell>
