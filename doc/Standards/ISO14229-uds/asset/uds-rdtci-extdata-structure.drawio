        <mxCell id="e12" parent="1" vertex="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=9;fontColor=#90a4ae;fontFamily=DejaVu Sans;" value="repeats once per DTCExtDataRecordNumber returned — 1 unless 0xFE/0xFF requested"><mxGeometry x="322" y="128" width="608" height="14" as="geometry" /></mxCell>
        <mxCell id="e13" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#90a4ae;dashed=1;" value=""><mxGeometry x="322" y="146" width="608" height="40" as="geometry" /></mxCell>
