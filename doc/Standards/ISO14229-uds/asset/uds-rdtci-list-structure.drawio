        <mxCell id="e15" parent="1" vertex="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#263238;fontFamily=DejaVu Sans;" value="Each DTCAndStatusRecord is exactly 4 bytes: the 3-byte DTC number plus its 1-byte statusOfDTC. A given DTC never repeats within one response."><mxGeometry x="20" y="220" width="920" height="16" as="geometry" /></mxCell>

        <mxCell id="e16" parent="1" vertex="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#263238;fontFamily=DejaVu Sans;fontStyle=1;" value="Example (Clause 11.3.5.3, Tables 295–296) — request 19 02 84, two of three stored DTCs match:"><mxGeometry x="20" y="246" width="920" height="16" as="geometry" /></mxCell>
