        <mxCell id="e1" parent="1" vertex="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#14337a;fontFamily=DejaVu Sans;fontStyle=1;" value="ReadDTCInformation 0x02 — reportDTCByStatusMask (Clause 11.3.2 / 11.3.3, Table 272)"><mxGeometry x="0" y="10" width="960" height="22" as="geometry" /></mxCell>
        <mxCell id="e2" parent="1" vertex="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#607d8b;fontFamily=DejaVu Sans;" value="&quot;List&quot; shape — shared with 0x0A–0x0E, 0x0F, 0x13, 0x15: same request as 0x01, but the response repeats one block per matching DTC."><mxGeometry x="20" y="40" width="920" height="16" as="geometry" /></mxCell>

        <mxCell id="e3" parent="1" vertex="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=9.5;fontColor=#f26f21;fontFamily=DejaVu Sans;fontStyle=1;" value="Request — client → server (Table 256) — identical shape to 0x01"><mxGeometry x="40" y="66" width="700" height="14" as="geometry" /></mxCell>
