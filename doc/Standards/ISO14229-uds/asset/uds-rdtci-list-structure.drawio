        <mxCell id="e18" parent="1" vertex="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=9.5;fontColor=#607d8b;fontFamily=DejaVu Sans;" value="DTCSAM=0x7F, then DTC 0x0A9B17/status 0x24, then DTC 0x080511/status 0x2F. DTC 0x25221F (status 0x00) is dropped — it does not match mask 0x84."><mxGeometry x="20" y="292" width="920" height="16" as="geometry" /></mxCell>
