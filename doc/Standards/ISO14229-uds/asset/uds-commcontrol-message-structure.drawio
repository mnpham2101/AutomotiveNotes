  <diagram name="uds-commcontrol-message-structure" id="uds-commcontrol-message-structure">
    <mxGraphModel dx="985" dy="1642" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="960" pageHeight="510" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="k1" parent="1" vertex="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#14337a;fontFamily=DejaVu Sans;fontStyle=1;" value="CommunicationControl — request and positive response A_Data structure (Clause 9.5.2.1 / 9.5.3.1, Tables 53 and 56)"><mxGeometry x="0" y="10" width="960" height="22" as="geometry" /></mxCell>
        <mxCell id="k2" parent="1" vertex="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#607d8b;fontFamily=DejaVu Sans;" value="Request = 0x28, controlType, communicationType — plus a 2-byte nodeIdentificationNumber only when controlType is 0x04 or 0x05."><mxGeometry x="20" y="40" width="920" height="16" as="geometry" /></mxCell>

        <!-- Request -->
        <mxCell id="k3" parent="1" vertex="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=9.5;fontColor=#f26f21;fontFamily=DejaVu Sans;fontStyle=1;" value="Request — client → server (Table 53)"><mxGeometry x="40" y="66" width="870" height="14" as="geometry" /></mxCell>
        <mxCell id="k4" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1565c0;fontSize=9;align=center;verticalAlign=middle;fontColor=#263238;fontFamily=DejaVu Sans;fontStyle=1;" value="CommunicationControl SID&#10;0x28&#10;CC · M — byte #1"><mxGeometry x="40" y="82" width="150" height="50" as="geometry" /></mxCell>
        <mxCell id="k5" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#f26f21;fontSize=9;align=center;verticalAlign=middle;fontColor=#263238;fontFamily=DejaVu Sans;fontStyle=1;" value="sub-function = controlType&#10;0x00 – 0xFF&#10;LEV_CTRLTP · M — byte #2"><mxGeometry x="200" y="82" width="200" height="50" as="geometry" /></mxCell>
        <mxCell id="k6" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2e7d32;fontSize=9;align=center;verticalAlign=middle;fontColor=#263238;fontFamily=DejaVu Sans;fontStyle=1;" value="communicationType&#10;0x00 – 0xFF&#10;CTP · M — byte #3, bit-coded"><mxGeometry x="410" y="82" width="180" height="50" as="geometry" /></mxCell>
        <mxCell id="k7" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ede7f6;strokeColor=#5e35b1;dashed=1;fontSize=9;align=center;verticalAlign=middle;fontColor=#263238;fontFamily=DejaVu Sans;fontStyle=1;" value="nodeIdentificationNumber (high, low)&#10;0x00 – 0xFF each&#10;NIN · C — bytes #4–#5, only if controlType = 0x04 or 0x05"><mxGeometry x="600" y="82" width="310" height="50" as="geometry" /></mxCell>

        <!-- Response -->
        <mxCell id="k8" parent="1" vertex="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=9.5;fontColor=#2e7d32;fontFamily=DejaVu Sans;fontStyle=1;" value="Positive response — server → client (Table 56)"><mxGeometry x="40" y="148" width="870" height="14" as="geometry" /></mxCell>
        <mxCell id="k9" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1565c0;fontSize=9;align=center;verticalAlign=middle;fontColor=#263238;fontFamily=DejaVu Sans;fontStyle=1;" value="CommunicationControl SID&#10;0x68&#10;CCPR · M — byte #1"><mxGeometry x="40" y="164" width="150" height="50" as="geometry" /></mxCell>
        <mxCell id="k10" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#f26f21;fontSize=9;align=center;verticalAlign=middle;fontColor=#263238;fontFamily=DejaVu Sans;fontStyle=1;" value="controlType — echo of bits 6-0&#10;0x00 – 0x7F&#10;LEV_CTRLTP · M — byte #2 (Table 57)"><mxGeometry x="200" y="164" width="200" height="50" as="geometry" /></mxCell>
        <mxCell id="k11" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eceff1;strokeColor=#90a4ae;fontSize=9;align=center;verticalAlign=middle;fontColor=#263238;fontFamily=DejaVu Sans;fontStyle=1;" value="nothing further&#10;the positive response is 2 bytes — neither communicationType nor nodeIdentificationNumber is echoed (Table 56)"><mxGeometry x="410" y="164" width="500" height="50" as="geometry" /></mxCell>

        <!-- communicationType expansion -->
        <mxCell id="k12" parent="1" edge="1" style="endArrow=none;html=1;strokeColor=#2e7d32;dashed=1;" value=""><mxGeometry relative="1" as="geometry"><mxPoint x="410" y="132" as="sourcePoint" /><mxPoint x="410" y="150" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="k13" parent="1" edge="1" style="endArrow=none;html=1;strokeColor=#2e7d32;dashed=1;" value=""><mxGeometry relative="1" as="geometry"><mxPoint x="590" y="132" as="sourcePoint" /><mxPoint x="590" y="150" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="k14" parent="1" vertex="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#263238;fontFamily=DejaVu Sans;fontStyle=1;" value="communicationType byte expanded (Annex B.1, Table B.1)"><mxGeometry x="20" y="230" width="920" height="16" as="geometry" /></mxCell>

        <mxCell id="k15" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2e7d32;fontSize=9.5;align=center;verticalAlign=middle;fontColor=#263238;fontFamily=DejaVu Sans;fontStyle=1;" value="bits 7 – 4 — subnetNumber&#10;0x0 = the receiving node and all its connected networks&#10;0xF = the network the request arrived on · 0x1–0xE = a specific subnet"><mxGeometry x="200" y="246" width="350" height="56" as="geometry" /></mxCell>
        <mxCell id="k16" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cfd8dc;fontSize=9.5;align=center;verticalAlign=middle;fontColor=#263238;fontFamily=DejaVu Sans;fontStyle=1;" value="bits 3 – 2&#10;ISOSAEReserved"><mxGeometry x="560" y="246" width="110" height="56" as="geometry" /></mxCell>
        <mxCell id="k17" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#f26f21;fontSize=9.5;align=center;verticalAlign=middle;fontColor=#263238;fontFamily=DejaVu Sans;fontStyle=1;" value="bits 1 – 0 — message class&#10;0x1 normalCommunicationMessages (NCM)&#10;0x2 networkManagement… (NWMCM) · 0x3 both"><mxGeometry x="680" y="246" width="230" height="56" as="geometry" /></mxCell>

        <mxCell id="k18" parent="1" vertex="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#263238;fontFamily=DejaVu Sans;fontStyle=1;" value="controlType sub-function values (Clause 9.5.2.2, Table 54) — bits 6-0, SPRMIB not shown"><mxGeometry x="20" y="318" width="920" height="16" as="geometry" /></mxCell>

        <!-- Column 1 -->
        <mxCell id="n1" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2e7d32;fontSize=10.5;align=left;verticalAlign=middle;fontColor=#263238;fontFamily=DejaVu Sans Mono;fontStyle=1;spacingLeft=10;" value="0x00"><mxGeometry x="40" y="334" width="80" height="28" as="geometry" /></mxCell>
        <mxCell id="n2" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2e7d32;fontSize=10;align=left;verticalAlign=middle;fontColor=#263238;fontFamily=DejaVu Sans;spacingLeft=10;" value="enableRxAndTx (ERXTX)"><mxGeometry x="120" y="334" width="330" height="28" as="geometry" /></mxCell>
        <mxCell id="n3" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#f26f21;fontSize=10.5;align=left;verticalAlign=middle;fontColor=#263238;fontFamily=DejaVu Sans Mono;fontStyle=1;spacingLeft=10;" value="0x01"><mxGeometry x="40" y="366" width="80" height="28" as="geometry" /></mxCell>
        <mxCell id="n4" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#f26f21;fontSize=10;align=left;verticalAlign=middle;fontColor=#263238;fontFamily=DejaVu Sans;spacingLeft=10;" value="enableRxAndDisableTx (ERXDTX)"><mxGeometry x="120" y="366" width="330" height="28" as="geometry" /></mxCell>
        <mxCell id="n5" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#f26f21;fontSize=10.5;align=left;verticalAlign=middle;fontColor=#263238;fontFamily=DejaVu Sans Mono;fontStyle=1;spacingLeft=10;" value="0x02"><mxGeometry x="40" y="398" width="80" height="28" as="geometry" /></mxCell>
        <mxCell id="n6" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#f26f21;fontSize=10;align=left;verticalAlign=middle;fontColor=#263238;fontFamily=DejaVu Sans;spacingLeft=10;" value="disableRxAndEnableTx (DRXETX)"><mxGeometry x="120" y="398" width="330" height="28" as="geometry" /></mxCell>
        <mxCell id="n7" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fce4ec;strokeColor=#c2185b;fontSize=10.5;align=left;verticalAlign=middle;fontColor=#263238;fontFamily=DejaVu Sans Mono;fontStyle=1;spacingLeft=10;" value="0x03"><mxGeometry x="40" y="430" width="80" height="28" as="geometry" /></mxCell>
        <mxCell id="n8" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fce4ec;strokeColor=#c2185b;fontSize=10;align=left;verticalAlign=middle;fontColor=#263238;fontFamily=DejaVu Sans;spacingLeft=10;" value="disableRxAndTx (DRXTX)"><mxGeometry x="120" y="430" width="330" height="28" as="geometry" /></mxCell>

        <!-- Column 2 -->
        <mxCell id="n9" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ede7f6;strokeColor=#5e35b1;fontSize=10.5;align=left;verticalAlign=middle;fontColor=#263238;fontFamily=DejaVu Sans Mono;fontStyle=1;spacingLeft=10;" value="0x04"><mxGeometry x="470" y="334" width="80" height="28" as="geometry" /></mxCell>
        <mxCell id="n10" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ede7f6;strokeColor=#5e35b1;fontSize=9.5;align=left;verticalAlign=middle;fontColor=#263238;fontFamily=DejaVu Sans;spacingLeft=10;" value="enableRxAndDisableTxWithEnhancedAddressInformation"><mxGeometry x="550" y="334" width="360" height="28" as="geometry" /></mxCell>
        <mxCell id="n11" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ede7f6;strokeColor=#5e35b1;fontSize=10.5;align=left;verticalAlign=middle;fontColor=#263238;fontFamily=DejaVu Sans Mono;fontStyle=1;spacingLeft=10;" value="0x05"><mxGeometry x="470" y="366" width="80" height="28" as="geometry" /></mxCell>
        <mxCell id="n12" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ede7f6;strokeColor=#5e35b1;fontSize=9.5;align=left;verticalAlign=middle;fontColor=#263238;fontFamily=DejaVu Sans;spacingLeft=10;" value="enableRxAndTxWithEnhancedAddressInformation"><mxGeometry x="550" y="366" width="360" height="28" as="geometry" /></mxCell>
        <mxCell id="n13" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cfd8dc;fontSize=10.5;align=left;verticalAlign=middle;fontColor=#263238;fontFamily=DejaVu Sans Mono;fontStyle=1;spacingLeft=10;" value="0x40–0x5F"><mxGeometry x="470" y="398" width="80" height="28" as="geometry" /></mxCell>
        <mxCell id="n14" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cfd8dc;fontSize=10;align=left;verticalAlign=middle;fontColor=#263238;fontFamily=DejaVu Sans;spacingLeft=10;" value="vehicleManufacturerSpecific (VMS)"><mxGeometry x="550" y="398" width="360" height="28" as="geometry" /></mxCell>
        <mxCell id="n15" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#f9a825;fontSize=10.5;align=left;verticalAlign=middle;fontColor=#263238;fontFamily=DejaVu Sans Mono;fontStyle=1;spacingLeft=10;" value="0x60–0x7E"><mxGeometry x="470" y="430" width="80" height="28" as="geometry" /></mxCell>
        <mxCell id="n16" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#f9a825;fontSize=10;align=left;verticalAlign=middle;fontColor=#263238;fontFamily=DejaVu Sans;spacingLeft=10;" value="systemSupplierSpecific (SSS)"><mxGeometry x="550" y="430" width="360" height="28" as="geometry" /></mxCell>

        <!-- Footers -->
        <mxCell id="k19" parent="1" vertex="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#263238;fontFamily=DejaVu Sans;" value="0x04 and 0x05 address a bus master: 0x04 switches the sub-bus segment to diagnostic-only scheduling, 0x05 back to application scheduling (Table 54)."><mxGeometry x="20" y="470" width="920" height="16" as="geometry" /></mxCell>
        <mxCell id="k20" parent="1" vertex="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#263238;fontFamily=DejaVu Sans;" value="Example (Tables 59–60): 28 01 02 — enableRxAndDisableTx for network management messages → positive response 68 01."><mxGeometry x="20" y="488" width="920" height="16" as="geometry" /></mxCell>

