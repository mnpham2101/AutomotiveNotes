<mxfile host="app.diagrams.net" agent="Claude" version="24.7.17">
  <diagram name="uds-rdtci-snapshot-structure" id="uds-rdtci-snapshot-structure">
    <mxGraphModel dx="985" dy="1642" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="960" pageHeight="460" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="e1" parent="1" vertex="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#14337a;fontFamily=DejaVu Sans;fontStyle=1;" value="ReadDTCInformation — snapshot family: 0x03 catalog vs 0x04 record data (Tables 257, 273, 274)"><mxGeometry x="0" y="10" width="960" height="22" as="geometry" /></mxCell>
        <mxCell id="e2" parent="1" vertex="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#607d8b;fontFamily=DejaVu Sans;" value="0x03 tells the client WHICH DTCSnapshot records exist; 0x04 fetches the DATA for ONE of them. Recommended: call 0x03 first, then 0x04 per record."><mxGeometry x="20" y="30" width="920" height="16" as="geometry" /></mxCell>

        <!-- Panel 1: 0x03 -->
        <mxCell id="e3" parent="1" vertex="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#f26f21;fontFamily=DejaVu Sans;fontStyle=1;" value="reportDTCSnapshotIdentification (0x03) — Request (Table 257) — 2 bytes, no DTC filter"><mxGeometry x="20" y="56" width="700" height="14" as="geometry" /></mxCell>
        <mxCell id="e4" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1565c0;fontSize=9;align=center;verticalAlign=middle;fontColor=#263238;fontFamily=DejaVu Sans;" value="SID 0x19"><mxGeometry x="20" y="72" width="80" height="36" as="geometry" /></mxCell>
        <mxCell id="e5" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#f26f21;fontSize=9;align=center;verticalAlign=middle;fontColor=#263238;fontFamily=DejaVu Sans;" value="reportType 0x03"><mxGeometry x="110" y="72" width="130" height="36" as="geometry" /></mxCell>

        <mxCell id="e6" parent="1" vertex="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#2e7d32;fontFamily=DejaVu Sans;fontStyle=1;" value="Positive response (Table 273)"><mxGeometry x="20" y="116" width="300" height="14" as="geometry" /></mxCell>
        <mxCell id="e7" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1565c0;fontSize=9;align=center;verticalAlign=middle;fontColor=#263238;fontFamily=DejaVu Sans;" value="0x59"><mxGeometry x="20" y="132" width="70" height="36" as="geometry" /></mxCell>
        <mxCell id="e8" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#f26f21;fontSize=9;align=center;verticalAlign=middle;fontColor=#263238;fontFamily=DejaVu Sans;" value="0x03 echo"><mxGeometry x="96" y="132" width="90" height="36" as="geometry" /></mxCell>
        <mxCell id="e9" parent="1" vertex="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=9;fontColor=#90a4ae;fontFamily=DejaVu Sans;" value="repeats once per stored snapshot record — 0..n times"><mxGeometry x="192" y="118" width="440" height="14" as="geometry" /></mxCell>
        <mxCell id="e10" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#90a4ae;dashed=1;" value=""><mxGeometry x="192" y="132" width="440" height="36" as="geometry" /></mxCell>
        <mxCell id="e11" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fce4ec;strokeColor=#c2185b;fontSize=8.5;align=center;verticalAlign=middle;fontColor=#263238;fontFamily=DejaVu Sans;" value="DTC [ HighByte, MiddleByte, LowByte ]"><mxGeometry x="200" y="138" width="210" height="24" as="geometry" /></mxCell>
        <mxCell id="e12" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e0f7fa;strokeColor=#00838f;fontSize=8.5;align=center;verticalAlign=middle;fontColor=#263238;fontFamily=DejaVu Sans;" value="DTCSnapshotRecordNumber"><mxGeometry x="418" y="138" width="206" height="24" as="geometry" /></mxCell>

        <mxCell id="e13" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f9fb;strokeColor=#cfd8dc;fontSize=9;align=left;verticalAlign=middle;spacingLeft=8;fontColor=#263238;fontFamily=DejaVu Sans Mono;" value="Example (11.3.5.5): 19 03  →  59 03 | 12 34 56 01 | 12 34 56 02 | 78 9A BC 01"><mxGeometry x="20" y="180" width="920" height="24" as="geometry" /></mxCell>
        <mxCell id="e14" parent="1" vertex="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=9.5;fontColor=#607d8b;fontFamily=DejaVu Sans;" value="DTC + record number ONLY — no status, no data. Three records here: DTC 0x123456 has two (#1, #2), DTC 0x789ABC has one (#1)."><mxGeometry x="20" y="212" width="920" height="16" as="geometry" /></mxCell>

        <mxCell id="e15" parent="1" edge="1" style="endArrow=none;html=1;strokeColor=#cfd8dc;" value=""><mxGeometry relative="1" as="geometry"><mxPoint x="20" y="238" as="sourcePoint" /><mxPoint x="940" y="238" as="targetPoint" /></mxGeometry></mxCell>

        <!-- Panel 2: 0x04 -->
        <mxCell id="e16" parent="1" vertex="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#f26f21;fontFamily=DejaVu Sans;fontStyle=1;" value="reportDTCSnapshotRecordByDTCNumber (0x04) — Request (Table 257) — targets one DTC + one record"><mxGeometry x="20" y="250" width="700" height="14" as="geometry" /></mxCell>
        <mxCell id="e17" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1565c0;fontSize=9;align=center;verticalAlign=middle;fontColor=#263238;fontFamily=DejaVu Sans;" value="0x19"><mxGeometry x="20" y="266" width="70" height="36" as="geometry" /></mxCell>
        <mxCell id="e18" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#f26f21;fontSize=9;align=center;verticalAlign=middle;fontColor=#263238;fontFamily=DejaVu Sans;" value="reportType 0x04"><mxGeometry x="96" y="266" width="90" height="36" as="geometry" /></mxCell>
        <mxCell id="e19" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fce4ec;strokeColor=#c2185b;fontSize=8.5;align=center;verticalAlign=middle;fontColor=#263238;fontFamily=DejaVu Sans;" value="DTCMaskRecord [ HB, MB, LB ]"><mxGeometry x="192" y="266" width="180" height="36" as="geometry" /></mxCell>
        <mxCell id="e20" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e0f7fa;strokeColor=#00838f;fontSize=8;align=center;verticalAlign=middle;fontColor=#263238;fontFamily=DejaVu Sans;" value="DTCSnapshotRecordNumber&#10;0xFF = all records for this DTC"><mxGeometry x="378" y="266" width="200" height="36" as="geometry" /></mxCell>

        <mxCell id="e21" parent="1" vertex="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#2e7d32;fontFamily=DejaVu Sans;fontStyle=1;" value="Positive response (Table 274)"><mxGeometry x="20" y="320" width="300" height="14" as="geometry" /></mxCell>
        <mxCell id="e22" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1565c0;fontSize=9;align=center;verticalAlign=middle;fontColor=#263238;fontFamily=DejaVu Sans;" value="0x59"><mxGeometry x="20" y="332" width="60" height="40" as="geometry" /></mxCell>
        <mxCell id="e23" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#f26f21;fontSize=9;align=center;verticalAlign=middle;fontColor=#263238;fontFamily=DejaVu Sans;" value="0x04"><mxGeometry x="84" y="332" width="80" height="40" as="geometry" /></mxCell>
        <mxCell id="e24" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fce4ec;strokeColor=#c2185b;fontSize=8;align=center;verticalAlign=middle;fontColor=#263238;fontFamily=DejaVu Sans;" value="DTC +&#10;statusOfDTC"><mxGeometry x="168" y="332" width="150" height="40" as="geometry" /></mxCell>
        <mxCell id="e25" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e0f7fa;strokeColor=#00838f;fontSize=8;align=center;verticalAlign=middle;fontColor=#263238;fontFamily=DejaVu Sans;" value="record #"><mxGeometry x="322" y="332" width="80" height="40" as="geometry" /></mxCell>
        <mxCell id="e26" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ede7f6;strokeColor=#5e35b1;fontSize=7.5;align=center;verticalAlign=middle;fontColor=#263238;fontFamily=DejaVu Sans;" value="#data&#10;identifiers"><mxGeometry x="406" y="332" width="80" height="40" as="geometry" /></mxCell>
        <mxCell id="e27" parent="1" vertex="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=9;fontColor=#90a4ae;fontFamily=DejaVu Sans;" value="repeats once per dataIdentifier in the record"><mxGeometry x="494" y="320" width="436" height="14" as="geometry" /></mxCell>
        <mxCell id="e28" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#90a4ae;dashed=1;" value=""><mxGeometry x="494" y="332" width="436" height="40" as="geometry" /></mxCell>
        <mxCell id="e29" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#f26f21;fontSize=8;align=center;verticalAlign=middle;fontColor=#263238;fontFamily=DejaVu Sans;" value="dataIdentifier"><mxGeometry x="502" y="338" width="150" height="28" as="geometry" /></mxCell>
        <mxCell id="e30" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2e7d32;fontSize=8;align=center;verticalAlign=middle;fontColor=#263238;fontFamily=DejaVu Sans;" value="snapshotData bytes"><mxGeometry x="660" y="338" width="262" height="28" as="geometry" /></mxCell>

        <mxCell id="e31" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f9fb;strokeColor=#cfd8dc;fontSize=9;align=left;verticalAlign=middle;spacingLeft=8;fontColor=#263238;fontFamily=DejaVu Sans Mono;" value="Example (11.3.5.6): 19 04 12 34 56 02  →  59 04 | 12 34 56 24 | 02 | 01 | 47 11 | A6 66 07 50 20"><mxGeometry x="20" y="384" width="920" height="24" as="geometry" /></mxCell>
        <mxCell id="e32" parent="1" vertex="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=9.5;fontColor=#607d8b;fontFamily=DejaVu Sans;" value="One DTC's record: status + record# + repeating (dataIdentifier, snapshotData). Record #2 of DTC 0x123456 (status 0x24), DID 0x4711, 5 data bytes."><mxGeometry x="20" y="416" width="920" height="16" as="geometry" /></mxCell>
        <mxCell id="e33" parent="1" vertex="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=9.5;fontColor=#607d8b;fontFamily=DejaVu Sans;" value="0x03 never carries statusOfDTC or data; 0x04 always targets exactly one DTC and, unless 0xFF, exactly one record."><mxGeometry x="20" y="434" width="920" height="16" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
