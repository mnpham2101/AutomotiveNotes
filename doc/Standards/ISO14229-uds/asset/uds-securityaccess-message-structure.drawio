<mxfile host="app.diagrams.net" agent="Claude" version="24.7.17">
  <diagram name="uds-securityaccess-message-structure" id="uds-securityaccess-message-structure">
    <mxGraphModel dx="985" dy="1642" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="960" pageHeight="460" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="s1" parent="1" vertex="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#14337a;fontFamily=DejaVu Sans;fontStyle=1;" value="SecurityAccess — seed and key exchange, A_Data structure (Clause 9.4.2 / 9.4.3, Tables 40, 41 and 44)"><mxGeometry x="0" y="10" width="960" height="22" as="geometry" /></mxCell>
        <mxCell id="s2" parent="1" vertex="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#607d8b;fontFamily=DejaVu Sans;" value="Two request/response pairs. requestSeed values are always odd; the matching sendKey value is requestSeed + 1 (Clause 9.4.2.2)."><mxGeometry x="20" y="40" width="920" height="16" as="geometry" /></mxCell>

        <!-- Step 1 requestSeed -->
        <mxCell id="s3" parent="1" vertex="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=9.5;fontColor=#f26f21;fontFamily=DejaVu Sans;fontStyle=1;" value="Step 1 — requestSeed · client → server (Table 40)"><mxGeometry x="40" y="64" width="870" height="14" as="geometry" /></mxCell>
        <mxCell id="s4" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1565c0;fontSize=9;align=center;verticalAlign=middle;fontColor=#263238;fontFamily=DejaVu Sans;fontStyle=1;" value="SecurityAccess Request SID&#10;0x27&#10;SA · M"><mxGeometry x="40" y="80" width="170" height="46" as="geometry" /></mxCell>
        <mxCell id="s5" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#f26f21;fontSize=9;align=center;verticalAlign=middle;fontColor=#263238;fontFamily=DejaVu Sans;fontStyle=1;" value="sub-function = securityAccessType&#10;0x01, 0x03, 0x05, 0x07 – 0x7D&#10;LEV_SAT_RSD · M — odd values"><mxGeometry x="220" y="80" width="250" height="46" as="geometry" /></mxCell>
        <mxCell id="s6" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eceff1;strokeColor=#90a4ae;dashed=1;fontSize=9;align=center;verticalAlign=middle;fontColor=#263238;fontFamily=DejaVu Sans;fontStyle=1;" value="securityAccessDataRecord — bytes #3 … #n&#10;0x00 – 0xFF&#10;SECACCDR_ · U — optional, e.g. an identification of the client verified in the server (Table 43)"><mxGeometry x="480" y="80" width="430" height="46" as="geometry" /></mxCell>

        <!-- Seed response -->
        <mxCell id="s7" parent="1" vertex="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=9.5;fontColor=#2e7d32;fontFamily=DejaVu Sans;fontStyle=1;" value="server → client · the seed (Table 44)"><mxGeometry x="40" y="132" width="870" height="14" as="geometry" /></mxCell>
        <mxCell id="s8" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1565c0;fontSize=9;align=center;verticalAlign=middle;fontColor=#263238;fontFamily=DejaVu Sans;fontStyle=1;" value="SecurityAccess Response SID&#10;0x67&#10;SAPR · M"><mxGeometry x="40" y="148" width="170" height="46" as="geometry" /></mxCell>
        <mxCell id="s9" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#f26f21;fontSize=9;align=center;verticalAlign=middle;fontColor=#263238;fontFamily=DejaVu Sans;fontStyle=1;" value="securityAccessType — echo of bits 6-0&#10;0x00 – 0x7F&#10;M (Table 45)"><mxGeometry x="220" y="148" width="250" height="46" as="geometry" /></mxCell>
        <mxCell id="s10" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2e7d32;fontSize=9;align=center;verticalAlign=middle;fontColor=#263238;fontFamily=DejaVu Sans;fontStyle=1;" value="securitySeed — seed#1 (high byte) … seed#m (low byte), bytes #3 … #n&#10;If level is locked: non-zero value; if already unlocked: 0x00 0x00 ... (all zeros)&#10;SECSEED_ · C — present when the request asked for the seed"><mxGeometry x="480" y="148" width="430" height="46" as="geometry" /></mxCell>

        <!-- Step 2 sendKey -->
        <mxCell id="s11" parent="1" vertex="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=9.5;fontColor=#f26f21;fontFamily=DejaVu Sans;fontStyle=1;" value="Step 2 — sendKey · client → server (Table 41)"><mxGeometry x="40" y="200" width="870" height="14" as="geometry" /></mxCell>
        <mxCell id="s12" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1565c0;fontSize=9;align=center;verticalAlign=middle;fontColor=#263238;fontFamily=DejaVu Sans;fontStyle=1;" value="SecurityAccess Request SID&#10;0x27&#10;SA · M"><mxGeometry x="40" y="216" width="170" height="46" as="geometry" /></mxCell>
        <mxCell id="s13" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#f26f21;fontSize=9;align=center;verticalAlign=middle;fontColor=#263238;fontFamily=DejaVu Sans;fontStyle=1;" value="sub-function = securityAccessType&#10;0x02, 0x04, 0x06, 0x08 – 0x7E&#10;LEV_SAT_SK · M — requestSeed + 1"><mxGeometry x="220" y="216" width="250" height="46" as="geometry" /></mxCell>
        <mxCell id="s14" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ede7f6;strokeColor=#5e35b1;fontSize=9;align=center;verticalAlign=middle;fontColor=#263238;fontFamily=DejaVu Sans;fontStyle=1;" value="securityKey — key#1 (high byte) … key#m (low byte), bytes #3 … #n&#10;0x00 – 0xFF&#10;SECKEY_ · M — generated by the security algorithm from the seed (Table 43)"><mxGeometry x="480" y="216" width="430" height="46" as="geometry" /></mxCell>

        <!-- Key response -->
        <mxCell id="s15" parent="1" vertex="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=9.5;fontColor=#2e7d32;fontFamily=DejaVu Sans;fontStyle=1;" value="server → client · unlocked (Table 44)"><mxGeometry x="40" y="268" width="870" height="14" as="geometry" /></mxCell>
        <mxCell id="s16" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1565c0;fontSize=9;align=center;verticalAlign=middle;fontColor=#263238;fontFamily=DejaVu Sans;fontStyle=1;" value="SecurityAccess Response SID&#10;0x67&#10;SAPR · M"><mxGeometry x="40" y="284" width="170" height="46" as="geometry" /></mxCell>
        <mxCell id="s17" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#f26f21;fontSize=9;align=center;verticalAlign=middle;fontColor=#263238;fontFamily=DejaVu Sans;fontStyle=1;" value="securityAccessType — echo of bits 6-0&#10;0x00 – 0x7F&#10;M (Table 45)"><mxGeometry x="220" y="284" width="250" height="46" as="geometry" /></mxCell>
        <mxCell id="s18" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eceff1;strokeColor=#90a4ae;fontSize=9;align=center;verticalAlign=middle;fontColor=#263238;fontFamily=DejaVu Sans;fontStyle=1;" value="no securitySeed&#10;the seed bytes appear only in the response to a requestSeed sub-function (Table 45)"><mxGeometry x="480" y="284" width="430" height="46" as="geometry" /></mxCell>

        <mxCell id="s19" parent="1" vertex="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#263238;fontFamily=DejaVu Sans;" value="Seed interpretation: NON-ZERO seed = security level is locked and must be unlocked via sendKey. ALL-ZERO seed (0x00 00 00...) = security level is already unlocked (no key needed). The server shall never send a non-zero seed for an already-unlocked level (Clause 9.4.1)."><mxGeometry x="20" y="342" width="920" height="24" as="geometry" /></mxCell>
        <mxCell id="s20" parent="1" vertex="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#263238;fontFamily=DejaVu Sans;fontStyle=1;" value="Worked example — level 0x01, seed 0x3657, key 0xC9A9 (Clause 9.4.5.1)"><mxGeometry x="20" y="377" width="920" height="16" as="geometry" /></mxCell>

        <mxCell id="x1" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#f26f21;fontSize=11;align=center;verticalAlign=middle;fontColor=#263238;fontFamily=DejaVu Sans Mono;fontStyle=1;" value="27 01&#10;requestSeed"><mxGeometry x="40" y="393" width="200" height="34" as="geometry" /></mxCell>
        <mxCell id="x2" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2e7d32;fontSize=11;align=center;verticalAlign=middle;fontColor=#263238;fontFamily=DejaVu Sans Mono;fontStyle=1;" value="67 01 36 57&#10;seed = 0x3657"><mxGeometry x="260" y="393" width="200" height="34" as="geometry" /></mxCell>
        <mxCell id="x3" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ede7f6;strokeColor=#5e35b1;fontSize=11;align=center;verticalAlign=middle;fontColor=#263238;fontFamily=DejaVu Sans Mono;fontStyle=1;" value="27 02 C9 A9&#10;sendKey, key = 0xC9A9"><mxGeometry x="480" y="393" width="200" height="34" as="geometry" /></mxCell>
        <mxCell id="x4" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2e7d32;fontSize=11;align=center;verticalAlign=middle;fontColor=#263238;fontFamily=DejaVu Sans Mono;fontStyle=1;" value="67 02&#10;key valid — level unlocked"><mxGeometry x="700" y="393" width="210" height="34" as="geometry" /></mxCell>

        <mxCell id="s21" parent="1" vertex="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#263238;fontFamily=DejaVu Sans;" value="Only one security level is active at a time: unlocking a new level deactivates whatever was unlocked before. An invalid key restarts the sequence from requestSeed (Clause 9.4.1, Annex I)."><mxGeometry x="20" y="439" width="920" height="16" as="geometry" /></mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
