        <mxCell id="e25" parent="1" vertex="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=9.5;fontColor=#263238;fontFamily=DejaVu Sans;" value="Test fails — bits 0, 1, 2 and 5 all set 0 → 1: pendingDTC and testFailedThisOperationCycle share the same set condition"><mxGeometry x="44" y="303" width="880" height="16" as="geometry" /></mxCell>

        <mxCell id="e26" parent="1" vertex="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f26f21;strokeColor=none;fontColor=#ffffff;fontSize=8;fontStyle=1;align=center;verticalAlign=middle;" value="2"><mxGeometry x="20" y="323" width="16" height="16" as="geometry" /></mxCell>
        <mxCell id="e27" parent="1" vertex="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=9.5;fontColor=#263238;fontFamily=DejaVu Sans;" value="Test passes — bit 0 resets 1 → 0 immediately; bits 1, 2 and 5 are untouched"><mxGeometry x="44" y="323" width="880" height="16" as="geometry" /></mxCell>

        <mxCell id="e28" parent="1" vertex="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f26f21;strokeColor=none;fontColor=#ffffff;fontSize=8;fontStyle=1;align=center;verticalAlign=middle;" value="3"><mxGeometry x="20" y="343" width="16" height="16" as="geometry" /></mxCell>
        <mxCell id="e29" parent="1" vertex="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=9.5;fontColor=#263238;fontFamily=DejaVu Sans;" value="Cycle 1 stops — bit 1 resets 1 → 0 (cycle-scoped), but bit 2 stays 1: that cycle wasn't clean"><mxGeometry x="44" y="343" width="880" height="16" as="geometry" /></mxCell>

        <mxCell id="e30" parent="1" vertex="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f26f21;strokeColor=none;fontColor=#ffffff;fontSize=8;fontStyle=1;align=center;verticalAlign=middle;" value="4"><mxGeometry x="20" y="363" width="16" height="16" as="geometry" /></mxCell>
        <mxCell id="e31" parent="1" vertex="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=9.5;fontColor=#263238;fontFamily=DejaVu Sans;" value="Cycle 2 stops with zero failures (bit 1 stayed 0 throughout) — only now does bit 2 reset 1 → 0"><mxGeometry x="44" y="363" width="880" height="16" as="geometry" /></mxCell>

        <mxCell id="e32" parent="1" vertex="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=9.5;fontColor=#607d8b;fontFamily=DejaVu Sans;" value="bit 5 never resets on its own; bit 2 resets automatically, but only after one full clean operation cycle [Annex D.2.3, Table D.5]."><mxGeometry x="20" y="394" width="920" height="16" as="geometry" /></mxCell>
        <mxCell id="e33" parent="1" vertex="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=8.5;fontColor=#90a4ae;fontFamily=DejaVu Sans;" value="Simplified — the real Table D.5 pseudocode also requires testNotCompletedThisOperationCycle == 0 (the test actually ran to completion)."><mxGeometry x="20" y="410" width="920" height="14" as="geometry" /></mxCell>
