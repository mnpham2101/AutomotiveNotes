        <mxCell id="c1" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1565c0;fontSize=11;align=center;verticalAlign=middle;fontColor=#263238;fontFamily=DejaVu Sans Mono;fontStyle=1;" value="2E"><mxGeometry x="40" y="278" width="43" height="38" as="geometry" /></mxCell>
