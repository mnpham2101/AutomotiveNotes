<mxfile host="app.diagrams.net" agent="Claude" version="24.7.17">
  <diagram name="uds-wdbi-request-message-structure" id="uds-wdbi-request-message-structure">
    <mxGraphModel dx="985" dy="1642" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="960" pageHeight="400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title / subtitle -->
        <mxCell id="w1" parent="1" vertex="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#14337a;fontFamily=DejaVu Sans;fontStyle=1;" value="WriteDataByIdentifier request — A_Data structure (Clause 10.7.2.1, Table 231)"><mxGeometry x="0" y="10" width="960" height="22" as="geometry" /></mxCell>
        <mxCell id="w2" parent="1" vertex="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#607d8b;fontFamily=DejaVu Sans;" value="Request = 0x2E, then exactly one 2-byte dataIdentifier, then the dataRecord to be written into the server. No sub-function byte (Clause 10.7.2.2)."><mxGeometry x="20" y="40" width="920" height="16" as="geometry" /></mxCell>

        <!-- Byte-level labels -->
        <mxCell id="w3" parent="1" vertex="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=9.5;fontColor=#90a4ae;fontFamily=DejaVu Sans;" value="A_Data byte #1"><mxGeometry x="40" y="62" width="150" height="14" as="geometry" /></mxCell>
        <mxCell id="w4" parent="1" vertex="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=9.5;fontColor=#90a4ae;fontFamily=DejaVu Sans;" value="A_Data byte #2"><mxGeometry x="200" y="62" width="150" height="14" as="geometry" /></mxCell>
        <mxCell id="w5" parent="1" vertex="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=9.5;fontColor=#90a4ae;fontFamily=DejaVu Sans;" value="A_Data byte #3"><mxGeometry x="360" y="62" width="150" height="14" as="geometry" /></mxCell>
        <mxCell id="w6" parent="1" vertex="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=9.5;fontColor=#90a4ae;fontFamily=DejaVu Sans;" value="A_Data byte #4 … #m+3"><mxGeometry x="520" y="62" width="390" height="14" as="geometry" /></mxCell>

        <!-- Byte-level boxes -->
        <mxCell id="w7" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1565c0;fontSize=9.5;align=center;verticalAlign=middle;fontColor=#263238;fontFamily=DejaVu Sans;fontStyle=1;" value="WriteDataByIdentifier SID&#10;0x2E&#10;WDBI · M (mandatory)"><mxGeometry x="40" y="80" width="150" height="52" as="geometry" /></mxCell>
        <mxCell id="w8" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#f26f21;fontSize=9.5;align=center;verticalAlign=middle;fontColor=#263238;fontFamily=DejaVu Sans;fontStyle=1;" value="dataIdentifier (MSB)&#10;0x00 – 0xFF&#10;DID_HB · M"><mxGeometry x="200" y="80" width="150" height="52" as="geometry" /></mxCell>
        <mxCell id="w9" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#f26f21;fontSize=9.5;align=center;verticalAlign=middle;fontColor=#263238;fontFamily=DejaVu Sans;fontStyle=1;" value="dataIdentifier (LSB)&#10;0x00 – 0xFF&#10;DID_LB · M"><mxGeometry x="360" y="80" width="150" height="52" as="geometry" /></mxCell>
        <mxCell id="w10" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2e7d32;fontSize=9.5;align=center;verticalAlign=middle;fontColor=#263238;fontFamily=DejaVu Sans;fontStyle=1;" value="dataRecord — m bytes, the value being written&#10;DREC_DATA1 … DREC_DATAm, each 0x00 – 0xFF&#10;first data byte M, the rest U — content and length are vehicle manufacturer specific (Table 232)"><mxGeometry x="520" y="80" width="390" height="52" as="geometry" /></mxCell>

        <!-- Note -->
        <mxCell id="w11" parent="1" vertex="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#263238;fontFamily=DejaVu Sans;" value="Exactly ONE dataIdentifier per request — unlike ReadDataByIdentifier (0x22), Table 231 defines a single DID followed by its dataRecord. Dynamically defined DIDs shall not be used (Clause 10.7.1)."><mxGeometry x="20" y="144" width="920" height="16" as="geometry" /></mxCell>

        <!-- Figure 21 length key -->
        <mxCell id="w12" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eceff1;strokeColor=#90a4ae;fontSize=10;align=left;verticalAlign=middle;fontColor=#263238;fontFamily=DejaVu Sans;spacingLeft=12;" value="&lt;b&gt;Figure 21 key — ① minimum length is 4 byte (SI + DID + DREC)   ② total length is 1 byte (SI + 2 byte DID + nth byte DREC)&lt;/b&gt;&#10;m is fixed by whatever that DID is defined to hold on the ECU, so the expected total is ECU-specific; a wrong length gives NRC 0x13."><mxGeometry x="40" y="164" width="870" height="42" as="geometry" /></mxCell>

        <!-- Connector down to the example -->
        <mxCell id="w13" parent="1" edge="1" style="endArrow=block;html=1;strokeColor=#2e7d32;" value=""><mxGeometry relative="1" as="geometry"><mxPoint x="475" y="214" as="sourcePoint" /><mxPoint x="475" y="238" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="w14" parent="1" vertex="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#263238;fontFamily=DejaVu Sans;fontStyle=1;" value="Worked example — write dataIdentifier 0xF190 (VIN) (Clause 10.7.5.2, Table 236)"><mxGeometry x="20" y="246" width="920" height="16" as="geometry" /></mxCell>

        <!-- Group labels over the byte strip -->
        <mxCell id="w15" parent="1" vertex="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=8.5;fontColor=#607d8b;fontFamily=DejaVu Sans;" value="SID"><mxGeometry x="40" y="264" width="43" height="12" as="geometry" /></mxCell>
        <mxCell id="w16" parent="1" vertex="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=8.5;fontColor=#607d8b;fontFamily=DejaVu Sans;" value="DID = 0xF190"><mxGeometry x="83" y="264" width="86" height="12" as="geometry" /></mxCell>
        <mxCell id="w17" parent="1" vertex="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=8.5;fontColor=#607d8b;fontFamily=DejaVu Sans;" value="dataRecord — 17 bytes, the VIN as ASCII"><mxGeometry x="169" y="264" width="731" height="12" as="geometry" /></mxCell>

