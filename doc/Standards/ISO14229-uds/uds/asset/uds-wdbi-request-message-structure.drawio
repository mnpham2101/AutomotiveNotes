        <!-- Footer notes -->
        <mxCell id="w18" parent="1" vertex="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#263238;fontFamily=DejaVu Sans;" value="Here m = 17, so the request is 20 bytes: 1 (SID) + 2 (DID) + 17 (dataRecord). The same VIN is what ReadDataByIdentifier returns for 0xF190 (Table 148)."><mxGeometry x="20" y="350" width="920" height="16" as="geometry" /></mxCell>
        <mxCell id="w19" parent="1" vertex="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#263238;fontFamily=DejaVu Sans;" value="Positive response is only 3 bytes — 0x6E plus the DID echo, no data (Clause 10.7.3.1, Table 233)."><mxGeometry x="20" y="368" width="920" height="16" as="geometry" /></mxCell>

