<mxfile host="app.diagrams.net" agent="Claude" version="24.7.17">
  <diagram name="uds-ecureset-message-structure" id="uds-ecureset-message-structure">
    <mxGraphModel dx="985" dy="1642" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="960" pageHeight="475" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="e1" parent="1" vertex="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#14337a;fontFamily=DejaVu Sans;fontStyle=1;" value="ECUReset — request and positive response A_Data structure (Clause 9.3.2.1 / 9.3.3.1, Tables 33 and 35)"><mxGeometry x="0" y="10" width="960" height="22" as="geometry" /></mxCell>
        <mxCell id="e2" parent="1" vertex="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#607d8b;fontFamily=DejaVu Sans;" value="Request = 0x11 plus the resetType sub-function; there are no data-parameters (Clause 9.3.2.3). The response echoes resetType and adds powerDownTime only for 0x04."><mxGeometry x="20" y="40" width="920" height="16" as="geometry" /></mxCell>

        <!-- Request -->
        <mxCell id="e3" parent="1" vertex="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=9.5;fontColor=#f26f21;fontFamily=DejaVu Sans;fontStyle=1;" value="Request — client → server (Table 33)"><mxGeometry x="40" y="66" width="540" height="14" as="geometry" /></mxCell>
        <mxCell id="e4" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1565c0;fontSize=9.5;align=center;verticalAlign=middle;fontColor=#263238;fontFamily=DejaVu Sans;fontStyle=1;" value="ECUReset Request SID&#10;0x11&#10;ER · M — A_Data byte #1"><mxGeometry x="40" y="82" width="200" height="50" as="geometry" /></mxCell>
        <mxCell id="e5" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#f26f21;fontSize=9.5;align=center;verticalAlign=middle;fontColor=#263238;fontFamily=DejaVu Sans;fontStyle=1;" value="sub-function = resetType&#10;0x00 – 0xFF&#10;LEV_RT_ · M — A_Data byte #2, bit 7 is SPRMIB"><mxGeometry x="250" y="82" width="330" height="50" as="geometry" /></mxCell>

        <!-- Response -->
        <mxCell id="e6" parent="1" vertex="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=9.5;fontColor=#2e7d32;fontFamily=DejaVu Sans;fontStyle=1;" value="Positive response — server → client (Table 35)"><mxGeometry x="40" y="148" width="870" height="14" as="geometry" /></mxCell>
        <mxCell id="e7" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1565c0;fontSize=9.5;align=center;verticalAlign=middle;fontColor=#263238;fontFamily=DejaVu Sans;fontStyle=1;" value="ECUReset Response SID&#10;0x51&#10;ERPR · M — A_Data byte #1"><mxGeometry x="40" y="164" width="200" height="50" as="geometry" /></mxCell>
        <mxCell id="e8" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#f26f21;fontSize=9.5;align=center;verticalAlign=middle;fontColor=#263238;fontFamily=DejaVu Sans;fontStyle=1;" value="resetType — echo of bits 6-0 of the request&#10;0x00 – 0x7F&#10;LEV_RT_ · M — A_Data byte #2 (Table 36)"><mxGeometry x="250" y="164" width="330" height="50" as="geometry" /></mxCell>
        <mxCell id="e9" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2e7d32;dashed=1;fontSize=9.5;align=center;verticalAlign=middle;fontColor=#263238;fontFamily=DejaVu Sans;fontStyle=1;" value="powerDownTime&#10;0x00 – 0xFF&#10;PDT · C — byte #3, present only if resetType = 0x04"><mxGeometry x="590" y="164" width="320" height="50" as="geometry" /></mxCell>

        <mxCell id="e10" parent="1" vertex="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#263238;fontFamily=DejaVu Sans;" value="powerDownTime is the minimum stand-by time the server will remain in the power-down sequence: 0x00–0xFE = 0–254 s at 1 s per count, 0xFF = failure or time not available (Table 36)."><mxGeometry x="20" y="226" width="920" height="16" as="geometry" /></mxCell>
        <mxCell id="e11" parent="1" vertex="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#263238;fontFamily=DejaVu Sans;fontStyle=1;" value="resetType sub-function values (Clause 9.3.2.2, Table 34) — bits 6-0, SPRMIB not shown"><mxGeometry x="20" y="246" width="920" height="16" as="geometry" /></mxCell>

        <!-- Column 1 -->
        <mxCell id="v1" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cfd8dc;fontSize=10.5;align=left;verticalAlign=middle;fontColor=#263238;fontFamily=DejaVu Sans Mono;fontStyle=1;spacingLeft=10;" value="0x00"><mxGeometry x="40" y="262" width="100" height="28" as="geometry" /></mxCell>
        <mxCell id="v2" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cfd8dc;fontSize=10.5;align=left;verticalAlign=middle;fontColor=#263238;fontFamily=DejaVu Sans;spacingLeft=10;" value="ISOSAEReserved (M)"><mxGeometry x="140" y="262" width="340" height="28" as="geometry" /></mxCell>
        <mxCell id="v3" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fce4ec;strokeColor=#c2185b;fontSize=10.5;align=left;verticalAlign=middle;fontColor=#263238;fontFamily=DejaVu Sans Mono;fontStyle=1;spacingLeft=10;" value="0x01"><mxGeometry x="40" y="294" width="100" height="28" as="geometry" /></mxCell>
        <mxCell id="v4" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fce4ec;strokeColor=#c2185b;fontSize=10.5;align=left;verticalAlign=middle;fontColor=#263238;fontFamily=DejaVu Sans;spacingLeft=10;" value="hardReset (HR) — simulates the power-on start-up"><mxGeometry x="140" y="294" width="340" height="28" as="geometry" /></mxCell>
        <mxCell id="v5" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#f26f21;fontSize=10.5;align=left;verticalAlign=middle;fontColor=#263238;fontFamily=DejaVu Sans Mono;fontStyle=1;spacingLeft=10;" value="0x02"><mxGeometry x="40" y="326" width="100" height="28" as="geometry" /></mxCell>
        <mxCell id="v6" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#f26f21;fontSize=10.5;align=left;verticalAlign=middle;fontColor=#263238;fontFamily=DejaVu Sans;spacingLeft=10;" value="keyOffOnReset (KOFFONR) — simulates key off / on"><mxGeometry x="140" y="326" width="340" height="28" as="geometry" /></mxCell>
        <mxCell id="v7" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2e7d32;fontSize=10.5;align=left;verticalAlign=middle;fontColor=#263238;fontFamily=DejaVu Sans Mono;fontStyle=1;spacingLeft=10;" value="0x03"><mxGeometry x="40" y="358" width="100" height="28" as="geometry" /></mxCell>
        <mxCell id="v8" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2e7d32;fontSize=10.5;align=left;verticalAlign=middle;fontColor=#263238;fontFamily=DejaVu Sans;spacingLeft=10;" value="softReset (SR) — restart the application program"><mxGeometry x="140" y="358" width="340" height="28" as="geometry" /></mxCell>
        <mxCell id="v9" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1565c0;fontSize=10.5;align=left;verticalAlign=middle;fontColor=#263238;fontFamily=DejaVu Sans Mono;fontStyle=1;spacingLeft=10;" value="0x04"><mxGeometry x="40" y="390" width="100" height="28" as="geometry" /></mxCell>
        <mxCell id="v10" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1565c0;fontSize=10.5;align=left;verticalAlign=middle;fontColor=#263238;fontFamily=DejaVu Sans;spacingLeft=10;" value="enableRapidPowerShutDown (ERPSD)"><mxGeometry x="140" y="390" width="340" height="28" as="geometry" /></mxCell>

        <!-- Column 2 -->
        <mxCell id="v11" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1565c0;fontSize=10.5;align=left;verticalAlign=middle;fontColor=#263238;fontFamily=DejaVu Sans Mono;fontStyle=1;spacingLeft=10;" value="0x05"><mxGeometry x="500" y="262" width="100" height="28" as="geometry" /></mxCell>
        <mxCell id="v12" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1565c0;fontSize=10.5;align=left;verticalAlign=middle;fontColor=#263238;fontFamily=DejaVu Sans;spacingLeft=10;" value="disableRapidPowerShutDown (DRPSD)"><mxGeometry x="600" y="262" width="310" height="28" as="geometry" /></mxCell>
        <mxCell id="v13" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cfd8dc;fontSize=10.5;align=left;verticalAlign=middle;fontColor=#263238;fontFamily=DejaVu Sans Mono;fontStyle=1;spacingLeft=10;" value="0x06–0x3F"><mxGeometry x="500" y="294" width="100" height="28" as="geometry" /></mxCell>
        <mxCell id="v14" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cfd8dc;fontSize=10.5;align=left;verticalAlign=middle;fontColor=#263238;fontFamily=DejaVu Sans;spacingLeft=10;" value="ISOSAEReserved (M)"><mxGeometry x="600" y="294" width="310" height="28" as="geometry" /></mxCell>
        <mxCell id="v15" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ede7f6;strokeColor=#5e35b1;fontSize=10.5;align=left;verticalAlign=middle;fontColor=#263238;fontFamily=DejaVu Sans Mono;fontStyle=1;spacingLeft=10;" value="0x40–0x5F"><mxGeometry x="500" y="326" width="100" height="28" as="geometry" /></mxCell>
        <mxCell id="v16" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ede7f6;strokeColor=#5e35b1;fontSize=10.5;align=left;verticalAlign=middle;fontColor=#263238;fontFamily=DejaVu Sans;spacingLeft=10;" value="vehicleManufacturerSpecific (VMS)"><mxGeometry x="600" y="326" width="310" height="28" as="geometry" /></mxCell>
        <mxCell id="v17" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#f9a825;fontSize=10.5;align=left;verticalAlign=middle;fontColor=#263238;fontFamily=DejaVu Sans Mono;fontStyle=1;spacingLeft=10;" value="0x60–0x7E"><mxGeometry x="500" y="358" width="100" height="28" as="geometry" /></mxCell>
        <mxCell id="v18" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#f9a825;fontSize=10.5;align=left;verticalAlign=middle;fontColor=#263238;fontFamily=DejaVu Sans;spacingLeft=10;" value="systemSupplierSpecific (SSS)"><mxGeometry x="600" y="358" width="310" height="28" as="geometry" /></mxCell>
        <mxCell id="v19" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cfd8dc;fontSize=10.5;align=left;verticalAlign=middle;fontColor=#263238;fontFamily=DejaVu Sans Mono;fontStyle=1;spacingLeft=10;" value="0x7F"><mxGeometry x="500" y="390" width="100" height="28" as="geometry" /></mxCell>
        <mxCell id="v20" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cfd8dc;fontSize=10.5;align=left;verticalAlign=middle;fontColor=#263238;fontFamily=DejaVu Sans;spacingLeft=10;" value="ISOSAEReserved (M)"><mxGeometry x="600" y="390" width="310" height="28" as="geometry" /></mxCell>

        <!-- Footers -->
        <mxCell id="e12" parent="1" vertex="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#263238;fontFamily=DejaVu Sans;" value="The positive response, if required, is sent BEFORE the reset is executed. After a successful reset the server activates the defaultSession (Clause 9.3.1)."><mxGeometry x="20" y="434" width="920" height="16" as="geometry" /></mxCell>
        <mxCell id="e13" parent="1" vertex="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#263238;fontFamily=DejaVu Sans;" value="Example (Tables 38–39): 11 01 — hardReset with SPRMIB = FALSE → positive response 51 01."><mxGeometry x="20" y="452" width="920" height="16" as="geometry" /></mxCell>

