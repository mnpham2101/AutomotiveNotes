  <diagram name="uds-rdbi-response-message-structure" id="uds-rdbi-response-message-structure">
    <mxGraphModel dx="985" dy="1642" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="960" pageHeight="460" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title / subtitle -->
        <mxCell id="p1" parent="1" vertex="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#14337a;fontFamily=DejaVu Sans;fontStyle=1;" value="ReadDataByIdentifier positive response — A_Data structure (Clause 10.2.3.1, Table 144)"><mxGeometry x="0" y="10" width="960" height="22" as="geometry" /></mxCell>
        <mxCell id="p2" parent="1" vertex="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#607d8b;fontFamily=DejaVu Sans;" value="Response = 0x62 followed by, for every requested dataIdentifier, the 2-byte DID echo immediately followed by that DID's dataRecord."><mxGeometry x="20" y="40" width="920" height="16" as="geometry" /></mxCell>

        <!-- Byte-level labels, first block -->
        <mxCell id="p3" parent="1" vertex="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=9.5;fontColor=#90a4ae;fontFamily=DejaVu Sans;" value="A_Data byte #1"><mxGeometry x="40" y="62" width="130" height="14" as="geometry" /></mxCell>
        <mxCell id="p4" parent="1" vertex="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=9.5;fontColor=#90a4ae;fontFamily=DejaVu Sans;" value="#2"><mxGeometry x="190" y="62" width="115" height="14" as="geometry" /></mxCell>
        <mxCell id="p5" parent="1" vertex="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=9.5;fontColor=#90a4ae;fontFamily=DejaVu Sans;" value="#3"><mxGeometry x="315" y="62" width="115" height="14" as="geometry" /></mxCell>
        <mxCell id="p6" parent="1" vertex="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=9.5;fontColor=#90a4ae;fontFamily=DejaVu Sans;" value="#4 … #(k-1)+4"><mxGeometry x="440" y="62" width="470" height="14" as="geometry" /></mxCell>

        <!-- Byte-level boxes, first block -->
        <mxCell id="p7" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1565c0;fontSize=9.5;align=center;verticalAlign=middle;fontColor=#263238;fontFamily=DejaVu Sans;fontStyle=1;" value="Response SID&#10;0x62&#10;RDBIPR · M"><mxGeometry x="40" y="80" width="130" height="52" as="geometry" /></mxCell>
        <mxCell id="p8" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#f26f21;fontSize=9.5;align=center;verticalAlign=middle;fontColor=#263238;fontFamily=DejaVu Sans;fontStyle=1;" value="DID #1 (MSB)&#10;0x00 – 0xFF&#10;DID_HB · M"><mxGeometry x="190" y="80" width="115" height="52" as="geometry" /></mxCell>
        <mxCell id="p9" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#f26f21;fontSize=9.5;align=center;verticalAlign=middle;fontColor=#263238;fontFamily=DejaVu Sans;fontStyle=1;" value="DID #1 (LSB)&#10;0x00 – 0xFF&#10;DID_LB · M"><mxGeometry x="315" y="80" width="115" height="52" as="geometry" /></mxCell>
        <mxCell id="p10" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2e7d32;fontSize=9.5;align=center;verticalAlign=middle;fontColor=#263238;fontFamily=DejaVu Sans;fontStyle=1;" value="dataRecord #1 — k bytes&#10;DREC_DATA1 … DREC_DATAk, each 0x00 – 0xFF&#10;first data byte M, the rest U — length and content are vehicle manufacturer specific"><mxGeometry x="440" y="80" width="470" height="52" as="geometry" /></mxCell>

        <!-- Repeating-block bracket -->
        <mxCell id="p11" parent="1" edge="1" style="endArrow=none;html=1;strokeColor=#5e35b1;" value=""><mxGeometry relative="1" as="geometry"><mxPoint x="190" y="140" as="sourcePoint" /><mxPoint x="910" y="140" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="p12" parent="1" vertex="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=9;fontColor=#5e35b1;fontFamily=DejaVu Sans;fontStyle=2;" value="one DID-echo + dataRecord block per requested dataIdentifier — repeated m times, in request order"><mxGeometry x="190" y="146" width="720" height="14" as="geometry" /></mxCell>
        <mxCell id="p13" parent="1" vertex="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;fontColor=#90a4ae;fontFamily=DejaVu Sans;" value="⋮"><mxGeometry x="440" y="164" width="80" height="14" as="geometry" /></mxCell>

        <!-- Byte-level labels, last block -->
        <mxCell id="p14" parent="1" vertex="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=9.5;fontColor=#90a4ae;fontFamily=DejaVu Sans;" value="#n-(o-1)-2"><mxGeometry x="190" y="180" width="115" height="14" as="geometry" /></mxCell>
        <mxCell id="p15" parent="1" vertex="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=9.5;fontColor=#90a4ae;fontFamily=DejaVu Sans;" value="#n-(o-1)-1"><mxGeometry x="315" y="180" width="115" height="14" as="geometry" /></mxCell>
        <mxCell id="p16" parent="1" vertex="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=9.5;fontColor=#90a4ae;fontFamily=DejaVu Sans;" value="#n-(o-1) … #n"><mxGeometry x="440" y="180" width="470" height="14" as="geometry" /></mxCell>

        <!-- Byte-level boxes, last block -->
        <mxCell id="p17" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#f26f21;dashed=1;fontSize=9.5;align=center;verticalAlign=middle;fontColor=#263238;fontFamily=DejaVu Sans;fontStyle=1;" value="DID #m (MSB)&#10;0x00 – 0xFF&#10;DID_HB · U"><mxGeometry x="190" y="198" width="115" height="52" as="geometry" /></mxCell>
        <mxCell id="p18" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#f26f21;dashed=1;fontSize=9.5;align=center;verticalAlign=middle;fontColor=#263238;fontFamily=DejaVu Sans;fontStyle=1;" value="DID #m (LSB)&#10;0x00 – 0xFF&#10;DID_LB · U"><mxGeometry x="315" y="198" width="115" height="52" as="geometry" /></mxCell>
        <mxCell id="p19" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2e7d32;dashed=1;fontSize=9.5;align=center;verticalAlign=middle;fontColor=#263238;fontFamily=DejaVu Sans;fontStyle=1;" value="dataRecord #m — o bytes&#10;DREC_DATA1 … DREC_DATAo, each 0x00 – 0xFF&#10;n = total A_Data length; the last dataRecord ends the message"><mxGeometry x="440" y="198" width="470" height="52" as="geometry" /></mxCell>

        <!-- Note -->
        <mxCell id="p20" parent="1" vertex="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#263238;fontFamily=DejaVu Sans;" value="No length byte separates the blocks: the client must already know how many bytes each DID returns (Table 145 — content of dataRecord is not defined by this document)."><mxGeometry x="20" y="264" width="920" height="16" as="geometry" /></mxCell>

        <!-- Connector down to the example -->
        <mxCell id="p21" parent="1" edge="1" style="endArrow=block;html=1;strokeColor=#2e7d32;" value=""><mxGeometry relative="1" as="geometry"><mxPoint x="480" y="282" as="sourcePoint" /><mxPoint x="480" y="306" as="targetPoint" /></mxGeometry></mxCell>
