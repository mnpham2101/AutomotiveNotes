        <mxCell id="lg1t" value="CAN frame — ISO 11898-1" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#37474f;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry x="62" y="484" width="160" height="14" as="geometry"/></mxCell>
