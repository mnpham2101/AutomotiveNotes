        <mxCell id="bbrt" value="first 6 bytes of the UDS response — the remaining 14 follow in Consecutive Frames" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#e65100;fontStyle=1;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry x="300" y="446" width="660" height="16" as="geometry"/></mxCell>
