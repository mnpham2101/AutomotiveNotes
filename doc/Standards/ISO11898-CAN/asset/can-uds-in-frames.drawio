        <mxCell id="lg3t" value="PCI — ISO 15765-2" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#37474f;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry x="524" y="484" width="130" height="14" as="geometry"/></mxCell>
        <mxCell id="lg4" value="" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#fff3e0;strokeColor=#f26f21;strokeWidth=1.6;fontSize=10;fontColor=#37474f;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry x="656" y="484" width="16" height="14" as="geometry"/></mxCell>
        <mxCell id="lg4t" value="UDS payload — ISO 14229-1" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#37474f;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry x="678" y="484" width="180" height="14" as="geometry"/></mxCell>
        <mxCell id="lg5" value="" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#cfd8dc;strokeWidth=1;fontSize=10;fontColor=#37474f;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry x="856" y="484" width="16" height="14" as="geometry"/></mxCell>
        <mxCell id="lg5t" value="padding" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#37474f;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry x="878" y="484" width="70" height="14" as="geometry"/></mxCell>
        <mxCell id="banner" value="UDS never touches the identifier, the CRC or the ACK — it only ever occupies part of the 8-byte data field, and ISO 15765-2 takes the first byte or two of that field for its own protocol control information. A single frame therefore carries at most &lt;b&gt;7 UDS bytes&lt;/b&gt;; anything longer is segmented across further frames." style="rounded=1;html=1;whiteSpace=wrap;fillColor=#fff3e0;strokeColor=#f26f21;align=left;spacingLeft=10;fontSize=11;fontColor=#e65100;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry x="40" y="514" width="920" height="48" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
