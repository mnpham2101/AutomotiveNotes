<mxfile host="app.diagrams.net" type="device">
  <diagram id="can-frame-structure" name="CAN frame structure">
    <mxGraphModel dx="1400" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="980" pageHeight="512" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="CAN data frame structure" style="text;html=1;align=center;verticalAlign=middle;fontSize=15;fontStyle=1;fontColor=#14337a;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry x="190" y="14" width="600" height="20" as="geometry"/></mxCell>

        <mxCell id="h1" value="Standard data frame — 11-bit identifier (base format)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#37474f;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry x="40" y="48" width="400" height="16" as="geometry"/></mxCell>

        <mxCell id="brA" value="" style="shape=mxgraph.flowchart.annotation_1;html=1;direction=north;strokeColor=#90a4ae;strokeWidth=1.2;fillColor=none;" vertex="1" parent="1"><mxGeometry x="78" y="88" width="180" height="6" as="geometry"/></mxCell>
        <mxCell id="brAt" value="Arbitration field" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontStyle=1;fontColor=#37474f;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry x="98" y="72" width="140" height="14" as="geometry"/></mxCell>
        <mxCell id="brB" value="" style="shape=mxgraph.flowchart.annotation_1;html=1;direction=north;strokeColor=#90a4ae;strokeWidth=1.2;fillColor=none;" vertex="1" parent="1"><mxGeometry x="258" y="88" width="149" height="6" as="geometry"/></mxCell>
        <mxCell id="brBt" value="Control field" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontStyle=1;fontColor=#37474f;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry x="272" y="72" width="120" height="14" as="geometry"/></mxCell>
        <mxCell id="brC" value="" style="shape=mxgraph.flowchart.annotation_1;html=1;direction=north;strokeColor=#90a4ae;strokeWidth=1.2;fillColor=none;" vertex="1" parent="1"><mxGeometry x="407" y="88" width="146" height="6" as="geometry"/></mxCell>
        <mxCell id="brCt" value="Data field" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontStyle=1;fontColor=#37474f;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry x="420" y="72" width="120" height="14" as="geometry"/></mxCell>
        <mxCell id="brD" value="" style="shape=mxgraph.flowchart.annotation_1;html=1;direction=north;strokeColor=#90a4ae;strokeWidth=1.2;fillColor=none;" vertex="1" parent="1"><mxGeometry x="553" y="88" width="159" height="6" as="geometry"/></mxCell>
        <mxCell id="brDt" value="CRC field" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontStyle=1;fontColor=#37474f;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry x="572" y="72" width="120" height="14" as="geometry"/></mxCell>
        <mxCell id="brE" value="" style="shape=mxgraph.flowchart.annotation_1;html=1;direction=north;strokeColor=#90a4ae;strokeWidth=1.2;fillColor=none;" vertex="1" parent="1"><mxGeometry x="712" y="88" width="110" height="6" as="geometry"/></mxCell>
        <mxCell id="brEt" value="ACK field" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontStyle=1;fontColor=#37474f;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry x="717" y="72" width="100" height="14" as="geometry"/></mxCell>
        <mxCell id="brF" value="" style="shape=mxgraph.flowchart.annotation_1;html=1;direction=north;strokeColor=#90a4ae;strokeWidth=1.2;fillColor=none;" vertex="1" parent="1"><mxGeometry x="822" y="88" width="68" height="6" as="geometry"/></mxCell>
        <mxCell id="brFt" value="End of frame" style="text;html=1;align=center;verticalAlign=middle;fontSize=9.5;fontStyle=1;fontColor=#37474f;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry x="811" y="72" width="90" height="14" as="geometry"/></mxCell>

        <mxCell id="f01" value="SOF&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#607d8b&quot;&gt;1&lt;/font&gt;" style="rounded=0;html=1;fillColor=#eceff1;strokeColor=#607d8b;strokeWidth=1.3;fontSize=10;fontStyle=1;fontColor=#263238;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry x="40" y="96" width="38" height="50" as="geometry"/></mxCell>
        <mxCell id="f02" value="Identifier&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#607d8b&quot;&gt;11&lt;/font&gt;" style="rounded=0;html=1;fillColor=#fff3e0;strokeColor=#f26f21;strokeWidth=1.5;fontSize=11.5;fontStyle=1;fontColor=#e65100;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry x="78" y="96" width="135" height="50" as="geometry"/></mxCell>
        <mxCell id="f03" value="RTR&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#607d8b&quot;&gt;1&lt;/font&gt;" style="rounded=0;html=1;fillColor=#fff3e0;strokeColor=#f26f21;strokeWidth=1.5;fontSize=9.5;fontStyle=1;fontColor=#e65100;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry x="213" y="96" width="45" height="50" as="geometry"/></mxCell>
        <mxCell id="f04" value="IDE&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#607d8b&quot;&gt;1&lt;/font&gt;" style="rounded=0;html=1;fillColor=#e3f2fd;strokeColor=#1565c0;strokeWidth=1.3;fontSize=9.5;fontStyle=1;fontColor=#14337a;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry x="258" y="96" width="43" height="50" as="geometry"/></mxCell>
        <mxCell id="f05" value="r0&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#607d8b&quot;&gt;1&lt;/font&gt;" style="rounded=0;html=1;fillColor=#e3f2fd;strokeColor=#1565c0;strokeWidth=1.3;fontSize=9.5;fontStyle=1;fontColor=#14337a;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry x="301" y="96" width="38" height="50" as="geometry"/></mxCell>
        <mxCell id="f06" value="DLC&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#607d8b&quot;&gt;4&lt;/font&gt;" style="rounded=0;html=1;fillColor=#e3f2fd;strokeColor=#1565c0;strokeWidth=1.3;fontSize=10.5;fontStyle=1;fontColor=#14337a;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry x="339" y="96" width="68" height="50" as="geometry"/></mxCell>
        <mxCell id="f07" value="Data&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#607d8b&quot;&gt;0–64 (0–8 bytes)&lt;/font&gt;" style="rounded=0;html=1;fillColor=#e8f5e9;strokeColor=#2e7d32;strokeWidth=1.5;fontSize=11.5;fontStyle=1;fontColor=#2e7d32;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry x="407" y="96" width="146" height="50" as="geometry"/></mxCell>
        <mxCell id="f08" value="CRC sequence&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#607d8b&quot;&gt;15&lt;/font&gt;" style="rounded=0;html=1;fillColor=#ffffff;strokeColor=#37474f;strokeWidth=1.3;fontSize=10;fontStyle=1;fontColor=#263238;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry x="553" y="96" width="101" height="50" as="geometry"/></mxCell>
        <mxCell id="f09" value="CRC&lt;br&gt;delimiter&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#607d8b&quot;&gt;1&lt;/font&gt;" style="rounded=0;html=1;fillColor=#ffffff;strokeColor=#37474f;strokeWidth=1.3;fontSize=8.5;fontStyle=1;fontColor=#263238;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry x="654" y="96" width="58" height="50" as="geometry"/></mxCell>
        <mxCell id="f10" value="ACK&lt;br&gt;slot&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#607d8b&quot;&gt;1&lt;/font&gt;" style="rounded=0;html=1;fillColor=#ffebee;strokeColor=#c62828;strokeWidth=1.5;fontSize=8.5;fontStyle=1;fontColor=#c62828;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry x="712" y="96" width="52" height="50" as="geometry"/></mxCell>
        <mxCell id="f11" value="ACK&lt;br&gt;delimiter&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#607d8b&quot;&gt;1&lt;/font&gt;" style="rounded=0;html=1;fillColor=#ffebee;strokeColor=#c62828;strokeWidth=1.5;fontSize=8.5;fontStyle=1;fontColor=#c62828;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry x="764" y="96" width="58" height="50" as="geometry"/></mxCell>
        <mxCell id="f12" value="EOF&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#607d8b&quot;&gt;7&lt;/font&gt;" style="rounded=0;html=1;fillColor=#eceff1;strokeColor=#90a4ae;strokeWidth=1.3;fontSize=10;fontStyle=1;fontColor=#263238;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry x="822" y="96" width="68" height="50" as="geometry"/></mxCell>
        <mxCell id="f13" value="IFS&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#607d8b&quot;&gt;3&lt;/font&gt;" style="rounded=0;html=1;fillColor=#eceff1;strokeColor=#90a4ae;strokeWidth=1.3;fontSize=10;fontStyle=1;fontColor=#263238;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry x="890" y="96" width="50" height="50" as="geometry"/></mxCell>

        <mxCell id="stuffSpan" value="" style="shape=mxgraph.flowchart.annotation_1;html=1;direction=south;strokeColor=#f26f21;strokeWidth=1.3;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="152" width="614" height="8" as="geometry"/></mxCell>
        <mxCell id="stuffT" value="bit stuffing applies over this span" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontStyle=1;fontColor=#e65100;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry x="247" y="164" width="200" height="14" as="geometry"/></mxCell>

        <mxCell id="a1" value="▸ &lt;b&gt;SOF&lt;/b&gt; — one dominant bit: it ends bus-idle and hard-synchronises every receiver's bit clock to the transmitter." style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#37474f;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry x="40" y="192" width="900" height="16" as="geometry"/></mxCell>
        <mxCell id="a2" value="▸ &lt;b&gt;Identifier&lt;/b&gt; — names the message, never the node. Its numeric value is also the priority: the lowest value wins arbitration." style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#37474f;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry x="40" y="212" width="900" height="16" as="geometry"/></mxCell>
        <mxCell id="a3" value="▸ &lt;b&gt;RTR&lt;/b&gt; dominant = data frame, recessive = remote frame. &lt;b&gt;IDE&lt;/b&gt; dominant = 11-bit format. &lt;b&gt;DLC&lt;/b&gt; = how many data bytes follow." style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#37474f;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry x="40" y="232" width="900" height="16" as="geometry"/></mxCell>
        <mxCell id="a4" value="▸ &lt;b&gt;CRC&lt;/b&gt; — 15 bits over SOF…data, then a recessive delimiter that gives every receiver a slot to react in." style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#37474f;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry x="40" y="252" width="900" height="16" as="geometry"/></mxCell>
        <mxCell id="a5" value="▸ &lt;b&gt;ACK slot&lt;/b&gt; — the transmitter sends recessive and lets any receiver overwrite it with dominant. &lt;b&gt;EOF&lt;/b&gt; 7 + &lt;b&gt;IFS&lt;/b&gt; 3 recessive bits close it." style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#37474f;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry x="40" y="272" width="900" height="16" as="geometry"/></mxCell>

        <mxCell id="h2" value="Extended data frame — 29-bit identifier" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#37474f;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry x="40" y="308" width="400" height="16" as="geometry"/></mxCell>

        <mxCell id="brX" value="" style="shape=mxgraph.flowchart.annotation_1;html=1;direction=north;strokeColor=#90a4ae;strokeWidth=1.2;fillColor=none;" vertex="1" parent="1"><mxGeometry x="78" y="346" width="408" height="6" as="geometry"/></mxCell>
        <mxCell id="brXt" value="Arbitration field — 32 bits" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontStyle=1;fontColor=#37474f;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry x="192" y="330" width="180" height="14" as="geometry"/></mxCell>

        <mxCell id="e01" value="SOF&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#607d8b&quot;&gt;1&lt;/font&gt;" style="rounded=0;html=1;fillColor=#eceff1;strokeColor=#607d8b;strokeWidth=1.3;fontSize=10;fontStyle=1;fontColor=#263238;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry x="40" y="354" width="38" height="46" as="geometry"/></mxCell>
        <mxCell id="e02" value="Base identifier&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#607d8b&quot;&gt;11&lt;/font&gt;" style="rounded=0;html=1;fillColor=#fff3e0;strokeColor=#f26f21;strokeWidth=1.5;fontSize=10;fontStyle=1;fontColor=#e65100;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry x="78" y="354" width="120" height="46" as="geometry"/></mxCell>
        <mxCell id="e03" value="SRR&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#607d8b&quot;&gt;1&lt;/font&gt;" style="rounded=0;html=1;fillColor=#fff3e0;strokeColor=#f26f21;strokeWidth=1.5;fontSize=9.5;fontStyle=1;fontColor=#e65100;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry x="198" y="354" width="46" height="46" as="geometry"/></mxCell>
        <mxCell id="e04" value="IDE&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#607d8b&quot;&gt;1&lt;/font&gt;" style="rounded=0;html=1;fillColor=#e3f2fd;strokeColor=#1565c0;strokeWidth=1.3;fontSize=9.5;fontStyle=1;fontColor=#14337a;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry x="244" y="354" width="46" height="46" as="geometry"/></mxCell>
        <mxCell id="e05" value="Identifier extension&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#607d8b&quot;&gt;18&lt;/font&gt;" style="rounded=0;html=1;fillColor=#fff3e0;strokeColor=#f26f21;strokeWidth=1.5;fontSize=10;fontStyle=1;fontColor=#e65100;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry x="290" y="354" width="150" height="46" as="geometry"/></mxCell>
        <mxCell id="e06" value="RTR&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#607d8b&quot;&gt;1&lt;/font&gt;" style="rounded=0;html=1;fillColor=#fff3e0;strokeColor=#f26f21;strokeWidth=1.5;fontSize=9.5;fontStyle=1;fontColor=#e65100;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry x="440" y="354" width="46" height="46" as="geometry"/></mxCell>
        <mxCell id="e07" value="r1&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#607d8b&quot;&gt;1&lt;/font&gt;" style="rounded=0;html=1;fillColor=#e3f2fd;strokeColor=#1565c0;strokeWidth=1.3;fontSize=9.5;fontStyle=1;fontColor=#14337a;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry x="486" y="354" width="38" height="46" as="geometry"/></mxCell>
        <mxCell id="e08" value="r0&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#607d8b&quot;&gt;1&lt;/font&gt;" style="rounded=0;html=1;fillColor=#e3f2fd;strokeColor=#1565c0;strokeWidth=1.3;fontSize=9.5;fontStyle=1;fontColor=#14337a;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry x="524" y="354" width="38" height="46" as="geometry"/></mxCell>
        <mxCell id="e09" value="DLC&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#607d8b&quot;&gt;4&lt;/font&gt;" style="rounded=0;html=1;fillColor=#e3f2fd;strokeColor=#1565c0;strokeWidth=1.3;fontSize=10.5;fontStyle=1;fontColor=#14337a;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry x="562" y="354" width="62" height="46" as="geometry"/></mxCell>
        <mxCell id="e10" value="Data · CRC · ACK · EOF · IFS&lt;br&gt;&lt;i&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#90a4ae&quot;&gt;identical to the standard frame&lt;/font&gt;&lt;/i&gt;" style="rounded=0;html=1;fillColor=#fafafa;strokeColor=#b0bec5;strokeWidth=1.3;dashed=1;dashPattern=5 3;fontSize=10.5;fontColor=#607d8b;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry x="624" y="354" width="316" height="46" as="geometry"/></mxCell>

        <mxCell id="x1" value="▸ &lt;b&gt;IDE recessive&lt;/b&gt; selects the 29-bit format — and because IDE sits inside the arbitration field, the format itself is arbitrated." style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#37474f;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry x="40" y="416" width="900" height="16" as="geometry"/></mxCell>
        <mxCell id="x2" value="▸ &lt;b&gt;SRR&lt;/b&gt; is a recessive placeholder in the standard frame's RTR position, so a standard frame with the same base ID always wins." style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#37474f;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry x="40" y="436" width="900" height="16" as="geometry"/></mxCell>

        <mxCell id="stuffBox" value="&lt;b&gt;Bit stuffing&lt;/b&gt; — after 5 consecutive bits of the same value the transmitter inserts one bit of the opposite value, from SOF through the CRC sequence.&lt;br&gt;It guarantees edges for resynchronisation. Receivers strip the stuff bits, so 6 identical bits in that span is by definition an error — how an error flag signals." style="rounded=1;html=1;fillColor=#fff3e0;strokeColor=#f26f21;fontSize=10.5;fontColor=#e65100;align=left;spacingLeft=12;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry x="40" y="458" width="900" height="46" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
