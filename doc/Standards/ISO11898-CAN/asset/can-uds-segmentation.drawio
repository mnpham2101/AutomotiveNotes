        <mxCell id="f2pad" value="padding — the receiver sends no data, it only grants permission to continue" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#cfd8dc;dashed=1;dashPattern=4 3;fontSize=10;fontColor=#b0bec5;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry x="513" y="242" width="435" height="44" as="geometry"/></mxCell>
        <mxCell id="lg0" value="" style="rounded=0;html=1;fillColor=#e3f2fd;strokeColor=#1565c0;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="40" y="452" width="16" height="14" as="geometry"/></mxCell>
        <mxCell id="lgt0" value="ISO 15765-2 protocol control information" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#37474f;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry x="62" y="452" width="270" height="14" as="geometry"/></mxCell>
        <mxCell id="lg1" value="" style="rounded=0;html=1;fillColor=#fff3e0;strokeColor=#f26f21;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="330" y="452" width="16" height="14" as="geometry"/></mxCell>
        <mxCell id="lgt1" value="UDS payload — ISO 14229-1" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#37474f;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry x="352" y="452" width="220" height="14" as="geometry"/></mxCell>
        <mxCell id="lg2" value="" style="rounded=0;html=1;fillColor=#f5f5f5;strokeColor=#cfd8dc;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="570" y="452" width="16" height="14" as="geometry"/></mxCell>
        <mxCell id="lgt2" value="padding" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#37474f;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry x="592" y="452" width="70" height="14" as="geometry"/></mxCell>
        <mxCell id="banner" value="&lt;b&gt;6 + 7 + 7 = 20.&lt;/b&gt; The First Frame spends two bytes on the length field and carries 6; each Consecutive Frame spends one on its sequence number and carries 7.&lt;br&gt;The &lt;b&gt;sequence number counts 1, 2 … 15, 0, 1 …&lt;/b&gt; so the receiver detects a lost or reordered frame. A gap aborts the transfer — no single segment is resent.&lt;br&gt;The &lt;b&gt;receiver&lt;/b&gt; sets the pace: BlockSize is how many Consecutive Frames may follow before the next Flow Control, STmin the minimum gap between them." style="rounded=1;html=1;whiteSpace=wrap;fillColor=#fff3e0;strokeColor=#f26f21;align=left;spacingLeft=10;fontSize=11;fontColor=#e65100;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry x="40" y="482" width="920" height="64" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
