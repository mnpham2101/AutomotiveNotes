<mxfile host="app.diagrams.net" type="device">
  <diagram id="can-uds-layers" name="CAN and UDS layer stack">
    <mxGraphModel dx="1400" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="940" pageHeight="516" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="Which ISO standard owns which layer — and where UDS plugs into CAN" style="text;html=1;align=center;verticalAlign=middle;fontSize=15;fontStyle=1;fontColor=#14337a;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry x="170" y="14" width="600" height="20" as="geometry"/></mxCell>
        <mxCell id="hL" value="OSI layer and the standard that defines it" style="text;html=1;align=center;verticalAlign=middle;fontSize=10.5;fontStyle=1;fontColor=#607d8b;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry x="150" y="48" width="340" height="14" as="geometry"/></mxCell>
        <mxCell id="hR" value="AUTOSAR Classic module" style="text;html=1;align=center;verticalAlign=middle;fontSize=10.5;fontStyle=1;fontColor=#607d8b;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry x="630" y="48" width="270" height="14" as="geometry"/></mxCell>

        <mxCell id="t7" value="7&lt;br&gt;&lt;font style=&quot;font-size:8.5px&quot; color=&quot;#b0bec5&quot;&gt;layer&lt;/font&gt;" style="rounded=0;html=1;fillColor=#14337a;strokeColor=none;fontSize=20;fontStyle=1;fontColor=#ffffff;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="70" height="82" as="geometry"/></mxCell>
        <mxCell id="c7" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#e65100&quot;&gt;Application&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;ISO 14229-1&lt;/b&gt; — UDS services: 0x22 ReadDataByIdentifier, 0x2E, 0x27 …&lt;br&gt;&lt;b&gt;ISO 14229-3&lt;/b&gt; — UDSonCAN: which UDS services run over CAN, and how&lt;br&gt;&lt;i&gt;&lt;font style=&quot;font-size:9.5px&quot; color=&quot;#90a4ae&quot;&gt;the diagnostic conversation itself — request, positive response, NRC&lt;/font&gt;&lt;/i&gt;" style="rounded=0;html=1;fillColor=#fff3e0;strokeColor=#f26f21;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=14;spacingTop=6;fontSize=10.5;fontColor=#37474f;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry x="110" y="70" width="490" height="82" as="geometry"/></mxCell>
        <mxCell id="m7" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Dcm&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px&quot; color=&quot;#607d8b&quot;&gt;(+ Dem for fault memory)&lt;/font&gt;" style="rounded=1;html=1;fillColor=#ffffff;strokeColor=#cfd8dc;fontSize=12;fontColor=#263238;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry x="630" y="70" width="270" height="82" as="geometry"/></mxCell>

        <mxCell id="t43" value="4–3&lt;br&gt;&lt;font style=&quot;font-size:8.5px&quot; color=&quot;#bbdefb&quot;&gt;layers&lt;/font&gt;" style="rounded=0;html=1;fillColor=#1565c0;strokeColor=none;fontSize=18;fontStyle=1;fontColor=#ffffff;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry x="40" y="160" width="70" height="94" as="geometry"/></mxCell>
        <mxCell id="c43" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#14337a&quot;&gt;Transport + Network&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;ISO 15765-2&lt;/b&gt; — DoCAN. Splits a UDS message of up to 4 095 bytes&lt;br&gt;into 8-byte CAN frames: SF, FF, CF, paced by FC (block size, STmin)&lt;br&gt;&lt;b&gt;ISO 15765-4&lt;/b&gt; — the restricted subset legislated OBD must use&lt;br&gt;&lt;i&gt;&lt;font style=&quot;font-size:9.5px&quot; color=&quot;#90a4ae&quot;&gt;this is the standard number to quote for &quot;UDS over CAN&quot;&lt;/font&gt;&lt;/i&gt;" style="rounded=0;html=1;fillColor=#e3f2fd;strokeColor=#1565c0;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=14;spacingTop=6;fontSize=10.5;fontColor=#37474f;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry x="110" y="160" width="490" height="94" as="geometry"/></mxCell>
        <mxCell id="m43" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;PduR → CanTp&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px&quot; color=&quot;#607d8b&quot;&gt;segmentation and reassembly&lt;br&gt;N_As / N_Bs / N_Cr timers&lt;/font&gt;" style="rounded=1;html=1;fillColor=#ffffff;strokeColor=#cfd8dc;fontSize=12;fontColor=#263238;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry x="630" y="160" width="270" height="94" as="geometry"/></mxCell>

        <mxCell id="t2" value="2&lt;br&gt;&lt;font style=&quot;font-size:8.5px&quot; color=&quot;#c8e6c9&quot;&gt;layer&lt;/font&gt;" style="rounded=0;html=1;fillColor=#2e7d32;strokeColor=none;fontSize=20;fontStyle=1;fontColor=#ffffff;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry x="40" y="262" width="70" height="82" as="geometry"/></mxCell>
        <mxCell id="c2" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#2e7d32&quot;&gt;Data link&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;ISO 11898-1&lt;/b&gt; — frame formats, bitwise arbitration, bit stuffing,&lt;br&gt;CRC, acknowledgement, error detection and error confinement&lt;br&gt;&lt;i&gt;&lt;font style=&quot;font-size:9.5px&quot; color=&quot;#90a4ae&quot;&gt;the protocol the CAN controller implements in silicon&lt;/font&gt;&lt;/i&gt;" style="rounded=0;html=1;fillColor=#e8f5e9;strokeColor=#2e7d32;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=14;spacingTop=6;fontSize=10.5;fontColor=#37474f;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry x="110" y="262" width="490" height="82" as="geometry"/></mxCell>
        <mxCell id="m2" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;CanIf → Can&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px&quot; color=&quot;#607d8b&quot;&gt;Can is the MCAL driver for the&lt;br&gt;on-chip CAN controller&lt;/font&gt;" style="rounded=1;html=1;fillColor=#ffffff;strokeColor=#cfd8dc;fontSize=12;fontColor=#263238;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry x="630" y="262" width="270" height="82" as="geometry"/></mxCell>

        <mxCell id="t1" value="1&lt;br&gt;&lt;font style=&quot;font-size:8.5px&quot; color=&quot;#ffe0b2&quot;&gt;layer&lt;/font&gt;" style="rounded=0;html=1;fillColor=#e65100;strokeColor=none;fontSize=20;fontStyle=1;fontColor=#ffffff;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry x="40" y="352" width="70" height="82" as="geometry"/></mxCell>
        <mxCell id="c1" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#c62828&quot;&gt;Physical&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;ISO 11898-2&lt;/b&gt; — high-speed CAN: differential levels, 120 Ω, ≤ 1 Mbit/s&lt;br&gt;&lt;b&gt;ISO 11898-3&lt;/b&gt; — low-speed fault-tolerant CAN: ≤ 125 kbit/s, survives a broken wire&lt;br&gt;&lt;i&gt;&lt;font style=&quot;font-size:9.5px&quot; color=&quot;#90a4ae&quot;&gt;two different physical protocols — this is the &quot;CAN is two standards&quot; split&lt;/font&gt;&lt;/i&gt;" style="rounded=0;html=1;fillColor=#ffebee;strokeColor=#c62828;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=14;spacingTop=6;fontSize=10.5;fontColor=#37474f;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry x="110" y="352" width="490" height="82" as="geometry"/></mxCell>
        <mxCell id="m1" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;CanTrcv&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px&quot; color=&quot;#607d8b&quot;&gt;MCAL driver for the transceiver IC,&lt;br&gt;plus the wiring and terminations&lt;/font&gt;" style="rounded=1;html=1;fillColor=#ffffff;strokeColor=#cfd8dc;fontSize=12;fontColor=#263238;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry x="630" y="352" width="270" height="82" as="geometry"/></mxCell>

        <mxCell id="banner" value="A 17-byte VIN read (62 F1 90 + 17 bytes) does not fit in one 8-byte CAN frame.&lt;br&gt;&lt;b&gt;ISO 15765-2&lt;/b&gt; is the glue: it turns that one UDS response into a First Frame plus Consecutive Frames, paced by the tester's Flow Control.&lt;br&gt;CAN carries bytes; ISO 15765-2 makes them a message; ISO 14229-1 gives them meaning." style="rounded=1;html=1;fillColor=#fff3e0;strokeColor=#f26f21;align=left;verticalAlign=middle;spacingLeft=12;fontSize=10.8;fontColor=#e65100;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry x="40" y="442" width="860" height="64" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
