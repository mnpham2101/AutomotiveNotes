<mxfile host="app.diagrams.net" type="device">
  <diagram id="can-ack-slot" name="CAN ACK slot">
    <mxGraphModel dx="1400" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="470" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="The ACK slot — the transmitter leaves a hole for the receivers to fill" style="text;html=1;align=center;verticalAlign=middle;fontSize=15;fontStyle=1;fontColor=#14337a;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry x="150" y="14" width="600" height="20" as="geometry"/></mxCell>
        <mxCell id="sub" value="one bit, driven by everyone who liked the CRC" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#607d8b;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry x="150" y="36" width="600" height="18" as="geometry"/></mxCell>

        <mxCell id="band" value="" style="rounded=0;html=1;fillColor=#fff3e0;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="486" y="62" width="118" height="234" as="geometry"/></mxCell>

        <mxCell id="h0" value="last CRC bit" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontStyle=1;fontColor=#607d8b;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry x="250" y="66" width="118" height="14" as="geometry"/></mxCell>
        <mxCell id="h1" value="CRC delimiter" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontStyle=1;fontColor=#607d8b;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry x="368" y="66" width="118" height="14" as="geometry"/></mxCell>
        <mxCell id="h2" value="ACK slot" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#e65100;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry x="486" y="66" width="118" height="14" as="geometry"/></mxCell>
        <mxCell id="h3" value="ACK delimiter" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontStyle=1;fontColor=#607d8b;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry x="604" y="66" width="118" height="14" as="geometry"/></mxCell>
        <mxCell id="h4" value="EOF bit 1" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontStyle=1;fontColor=#607d8b;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry x="722" y="66" width="118" height="14" as="geometry"/></mxCell>

        <mxCell id="rt" value="Transmitter&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#607d8b&quot;&gt;drives&lt;/font&gt;" style="text;html=1;align=right;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#263238;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry x="100" y="93" width="142" height="28" as="geometry"/></mxCell>
        <mxCell id="t0" value="0 / 1" style="rounded=0;html=1;fillColor=#fafafa;strokeColor=#b0bec5;fontSize=12;fontColor=#90a4ae;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry x="250" y="88" width="118" height="38" as="geometry"/></mxCell>
        <mxCell id="t1" value="1" style="rounded=0;html=1;fillColor=#ffffff;strokeColor=#b0bec5;fontSize=15;fontStyle=1;fontColor=#607d8b;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry x="368" y="88" width="118" height="38" as="geometry"/></mxCell>
        <mxCell id="t2" value="1&lt;br&gt;&lt;font style=&quot;font-size:8.5px&quot;&gt;recessive — released&lt;/font&gt;" style="rounded=0;html=1;fillColor=#ffffff;strokeColor=#f26f21;strokeWidth=2.6;fontSize=15;fontStyle=1;fontColor=#e65100;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry x="486" y="88" width="118" height="38" as="geometry"/></mxCell>
        <mxCell id="t3" value="1" style="rounded=0;html=1;fillColor=#ffffff;strokeColor=#b0bec5;fontSize=15;fontStyle=1;fontColor=#607d8b;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry x="604" y="88" width="118" height="38" as="geometry"/></mxCell>
        <mxCell id="t4" value="1" style="rounded=0;html=1;fillColor=#ffffff;strokeColor=#b0bec5;fontSize=15;fontStyle=1;fontColor=#607d8b;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry x="722" y="88" width="118" height="38" as="geometry"/></mxCell>

        <mxCell id="r1l" value="Receiver 1&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#2e7d32&quot;&gt;CRC OK&lt;/font&gt;" style="text;html=1;align=right;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#263238;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry x="100" y="141" width="142" height="28" as="geometry"/></mxCell>
        <mxCell id="a0" value="not driving" style="rounded=0;html=1;fillColor=#eceff1;strokeColor=#cfd8dc;dashed=1;dashPattern=3 3;fontSize=9;fontColor=#b0bec5;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry x="250" y="136" width="118" height="38" as="geometry"/></mxCell>
        <mxCell id="a1" value="not driving" style="rounded=0;html=1;fillColor=#eceff1;strokeColor=#cfd8dc;dashed=1;dashPattern=3 3;fontSize=9;fontColor=#b0bec5;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry x="368" y="136" width="118" height="38" as="geometry"/></mxCell>
        <mxCell id="a2" value="0&lt;br&gt;&lt;font style=&quot;font-size:8.5px&quot; color=&quot;#cfd8dc&quot;&gt;dominant&lt;/font&gt;" style="rounded=0;html=1;fillColor=#37474f;strokeColor=#f26f21;strokeWidth=2.6;fontSize=15;fontStyle=1;fontColor=#ffffff;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry x="486" y="136" width="118" height="38" as="geometry"/></mxCell>
        <mxCell id="a3" value="not driving" style="rounded=0;html=1;fillColor=#eceff1;strokeColor=#cfd8dc;dashed=1;dashPattern=3 3;fontSize=9;fontColor=#b0bec5;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry x="604" y="136" width="118" height="38" as="geometry"/></mxCell>
        <mxCell id="a4" value="not driving" style="rounded=0;html=1;fillColor=#eceff1;strokeColor=#cfd8dc;dashed=1;dashPattern=3 3;fontSize=9;fontColor=#b0bec5;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry x="722" y="136" width="118" height="38" as="geometry"/></mxCell>

        <mxCell id="r2l" value="Receiver 2&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#2e7d32&quot;&gt;CRC OK&lt;/font&gt;" style="text;html=1;align=right;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#263238;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry x="100" y="189" width="142" height="28" as="geometry"/></mxCell>
        <mxCell id="b0" value="not driving" style="rounded=0;html=1;fillColor=#eceff1;strokeColor=#cfd8dc;dashed=1;dashPattern=3 3;fontSize=9;fontColor=#b0bec5;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry x="250" y="184" width="118" height="38" as="geometry"/></mxCell>
        <mxCell id="b1" value="not driving" style="rounded=0;html=1;fillColor=#eceff1;strokeColor=#cfd8dc;dashed=1;dashPattern=3 3;fontSize=9;fontColor=#b0bec5;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry x="368" y="184" width="118" height="38" as="geometry"/></mxCell>
        <mxCell id="b2" value="0&lt;br&gt;&lt;font style=&quot;font-size:8.5px&quot; color=&quot;#cfd8dc&quot;&gt;dominant&lt;/font&gt;" style="rounded=0;html=1;fillColor=#37474f;strokeColor=#f26f21;strokeWidth=2.6;fontSize=15;fontStyle=1;fontColor=#ffffff;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry x="486" y="184" width="118" height="38" as="geometry"/></mxCell>
        <mxCell id="b3" value="not driving" style="rounded=0;html=1;fillColor=#eceff1;strokeColor=#cfd8dc;dashed=1;dashPattern=3 3;fontSize=9;fontColor=#b0bec5;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry x="604" y="184" width="118" height="38" as="geometry"/></mxCell>
        <mxCell id="b4" value="not driving" style="rounded=0;html=1;fillColor=#eceff1;strokeColor=#cfd8dc;dashed=1;dashPattern=3 3;fontSize=9;fontColor=#b0bec5;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry x="722" y="184" width="118" height="38" as="geometry"/></mxCell>

        <mxCell id="busl" value="Resulting bus level&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#607d8b&quot;&gt;wired-AND&lt;/font&gt;" style="text;html=1;align=right;verticalAlign=middle;fontSize=11.5;fontStyle=1;fontColor=#e65100;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry x="90" y="255" width="152" height="28" as="geometry"/></mxCell>
        <mxCell id="u0" value="0 / 1" style="rounded=0;html=1;fillColor=#fafafa;strokeColor=#f26f21;strokeWidth=1.8;fontSize=12;fontColor=#90a4ae;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry x="250" y="250" width="118" height="38" as="geometry"/></mxCell>
        <mxCell id="u1" value="1" style="rounded=0;html=1;fillColor=#ffffff;strokeColor=#f26f21;strokeWidth=1.8;fontSize=15;fontStyle=1;fontColor=#607d8b;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry x="368" y="250" width="118" height="38" as="geometry"/></mxCell>
        <mxCell id="u2" value="0&lt;br&gt;&lt;font style=&quot;font-size:8.5px&quot; color=&quot;#cfd8dc&quot;&gt;acknowledged&lt;/font&gt;" style="rounded=0;html=1;fillColor=#37474f;strokeColor=#f26f21;strokeWidth=2.6;fontSize=15;fontStyle=1;fontColor=#ffffff;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry x="486" y="250" width="118" height="38" as="geometry"/></mxCell>
        <mxCell id="u3" value="1" style="rounded=0;html=1;fillColor=#ffffff;strokeColor=#f26f21;strokeWidth=1.8;fontSize=15;fontStyle=1;fontColor=#607d8b;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry x="604" y="250" width="118" height="38" as="geometry"/></mxCell>
        <mxCell id="u4" value="1" style="rounded=0;html=1;fillColor=#ffffff;strokeColor=#f26f21;strokeWidth=1.8;fontSize=15;fontStyle=1;fontColor=#607d8b;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry x="722" y="250" width="118" height="38" as="geometry"/></mxCell>

        <mxCell id="readback" style="endArrow=block;html=1;strokeColor=#f26f21;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="545" y="322" as="sourcePoint"/><mxPoint x="545" y="292" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="readbackt" value="the transmitter samples the bus here — it reads dominant, so someone received the frame" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#e65100;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry x="200" y="330" width="690" height="16" as="geometry"/></mxCell>

        <mxCell id="n1" value="▸ The transmitter &lt;b&gt;deliberately sends recessive&lt;/b&gt; in the ACK slot, so any receiver can overwrite it — dominant always wins." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#37474f;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry x="30" y="366" width="860" height="16" as="geometry"/></mxCell>
        <mxCell id="n2" value="▸ Every node that computed a matching CRC drives that one bit dominant. Ten receivers or one — the bus looks the same." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#37474f;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry x="30" y="388" width="860" height="16" as="geometry"/></mxCell>
        <mxCell id="n3" value="▸ &lt;b&gt;It is a bus-level ACK, not end-to-end&lt;/b&gt;: it proves somebody heard the frame, never that the intended ECU did — that guarantee is UDS's job." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#37474f;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry x="30" y="410" width="860" height="16" as="geometry"/></mxCell>
        <mxCell id="n4" value="▸ No dominant bit ⇒ &lt;b&gt;ACK error&lt;/b&gt;: the transmitter raises an error frame, adds 8 to its transmit error counter, and retransmits the frame automatically." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#37474f;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry x="30" y="432" width="860" height="16" as="geometry"/></mxCell>
        <mxCell id="n5" value="▸ A node alone on a bench bus never gets an ACK — it retries until it turns error-passive, then stays there rather than reaching bus-off." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#37474f;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry x="30" y="454" width="860" height="16" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
