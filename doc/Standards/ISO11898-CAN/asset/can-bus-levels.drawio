        <mxCell id="hdr2" value="What the receiver actually measures: V_diff = V(CAN_H) − V(CAN_L)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.5;fontStyle=1;fontColor=#37474f;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry x="60" y="290" width="480" height="16" as="geometry"/></mxCell>

        <mxCell id="bandD" value="" style="rounded=0;html=1;fillColor=#ffebee;strokeColor=none;opacity=55;" vertex="1" parent="1"><mxGeometry x="120" y="316" width="760" height="34.5" as="geometry"/></mxCell>
        <mxCell id="bandR" value="" style="rounded=0;html=1;fillColor=#eceff1;strokeColor=none;opacity=80;" vertex="1" parent="1"><mxGeometry x="120" y="381.5" width="760" height="33.5" as="geometry"/></mxCell>

        <mxCell id="d00" style="endArrow=none;html=1;strokeColor=#b0bec5;strokeWidth=1.4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="120" y="415" as="sourcePoint"/><mxPoint x="880" y="415" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="d09" style="endArrow=none;html=1;strokeColor=#f26f21;strokeWidth=1.4;dashed=1;dashPattern=5 3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="120" y="356.5" as="sourcePoint"/><mxPoint x="880" y="356.5" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="d05" style="endArrow=none;html=1;strokeColor=#607d8b;strokeWidth=1.4;dashed=1;dashPattern=5 3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="120" y="381.5" as="sourcePoint"/><mxPoint x="880" y="381.5" as="targetPoint"/></mxGeometry></mxCell>

        <mxCell id="dl20" value="2.0 V" style="text;html=1;align=right;verticalAlign=middle;fontSize=10.5;fontColor=#607d8b;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry x="62" y="317" width="50" height="16" as="geometry"/></mxCell>
        <mxCell id="dl09" value="0.9 V" style="text;html=1;align=right;verticalAlign=middle;fontSize=10.5;fontColor=#e65100;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry x="62" y="348" width="50" height="16" as="geometry"/></mxCell>
        <mxCell id="dl05" value="0.5 V" style="text;html=1;align=right;verticalAlign=middle;fontSize=10.5;fontColor=#607d8b;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry x="62" y="373" width="50" height="16" as="geometry"/></mxCell>
        <mxCell id="dl00" value="0 V" style="text;html=1;align=right;verticalAlign=middle;fontSize=10.5;fontColor=#607d8b;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry x="62" y="407" width="50" height="16" as="geometry"/></mxCell>

        <mxCell id="annD" value="DOMINANT" style="text;html=1;align=left;verticalAlign=middle;fontSize=9;fontStyle=3;fontColor=#c62828;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry x="126" y="324" width="90" height="14" as="geometry"/></mxCell>
        <mxCell id="annR" value="RECESSIVE" style="text;html=1;align=left;verticalAlign=middle;fontSize=9;fontStyle=3;fontColor=#607d8b;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry x="126" y="390" width="90" height="14" as="geometry"/></mxCell>

        <mxCell id="traceD" style="endArrow=none;html=1;strokeColor=#e65100;strokeWidth=2.8;edgeStyle=none;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="120" y="415" as="sourcePoint"/><mxPoint x="880" y="325" as="targetPoint"/><Array as="points"><mxPoint x="215" y="415"/><mxPoint x="215" y="325"/><mxPoint x="310" y="325"/><mxPoint x="310" y="415"/><mxPoint x="405" y="415"/><mxPoint x="405" y="325"/><mxPoint x="595" y="325"/><mxPoint x="595" y="415"/><mxPoint x="785" y="415"/><mxPoint x="785" y="325"/></Array></mxGeometry></mxCell>

        <mxCell id="note1" value="▸ Recessive = 1 — nobody drives; the terminations hold both wires together at ≈ 2.5 V, so V_diff ≈ 0 V." style="text;html=1;align=left;verticalAlign=middle;fontSize=11.5;fontColor=#37474f;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry x="60" y="437" width="860" height="16" as="geometry"/></mxCell>
        <mxCell id="note2" value="▸ Dominant = 0 — a driver pushes CAN_H up to ≈ 3.5 V and pulls CAN_L down to ≈ 1.5 V, so V_diff ≈ 2 V." style="text;html=1;align=left;verticalAlign=middle;fontSize=11.5;fontColor=#37474f;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry x="60" y="459" width="860" height="16" as="geometry"/></mxCell>
        <mxCell id="note3" value="▸ The receiver decides on the difference alone: above &lt;b&gt;0.9 V&lt;/b&gt; it reads dominant, below &lt;b&gt;0.5 V&lt;/b&gt; recessive. The gap between is deliberate hysteresis." style="text;html=1;align=left;verticalAlign=middle;fontSize=11.5;fontColor=#37474f;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry x="60" y="481" width="860" height="16" as="geometry"/></mxCell>
        <mxCell id="note4" value="▸ Dominant always wins: one node driving 0 forces the whole bus to 0, whatever the others send (wired-AND)." style="text;html=1;align=left;verticalAlign=middle;fontSize=11.5;fontColor=#37474f;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry x="60" y="503" width="860" height="16" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
