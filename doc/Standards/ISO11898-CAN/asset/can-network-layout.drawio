        <mxCell id="lblH" value="CAN_H" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#c62828;labelBackgroundColor=#ffffff;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry x="248" y="247" width="56" height="16" as="geometry"/></mxCell>
        <mxCell id="lblL" value="CAN_L" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#1565c0;labelBackgroundColor=#ffffff;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry x="248" y="282" width="56" height="16" as="geometry"/></mxCell>

        <mxCell id="termLw1" style="endArrow=none;html=1;strokeColor=#263238;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="55" y="255" as="sourcePoint"/><mxPoint x="55" y="259" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="termL" value="" style="rounded=0;html=1;fillColor=#eceff1;strokeColor=#263238;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="48" y="259" width="14" height="27" as="geometry"/></mxCell>
        <mxCell id="termLw2" style="endArrow=none;html=1;strokeColor=#263238;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="55" y="286" as="sourcePoint"/><mxPoint x="55" y="290" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="termLv" value="120 Ω" style="text;html=1;align=center;verticalAlign=middle;fontSize=11.5;fontStyle=1;fontColor=#263238;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry x="25" y="228" width="60" height="16" as="geometry"/></mxCell>
        <mxCell id="termLn" value="termination" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#607d8b;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry x="25" y="298" width="60" height="14" as="geometry"/></mxCell>

        <mxCell id="termRw1" style="endArrow=none;html=1;strokeColor=#263238;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="900" y="255" as="sourcePoint"/><mxPoint x="900" y="259" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="termR" value="" style="rounded=0;html=1;fillColor=#eceff1;strokeColor=#263238;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="893" y="259" width="14" height="27" as="geometry"/></mxCell>
        <mxCell id="termRw2" style="endArrow=none;html=1;strokeColor=#263238;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="900" y="286" as="sourcePoint"/><mxPoint x="900" y="290" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="termRv" value="120 Ω" style="text;html=1;align=center;verticalAlign=middle;fontSize=11.5;fontStyle=1;fontColor=#263238;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry x="870" y="228" width="60" height="16" as="geometry"/></mxCell>
        <mxCell id="termRn" value="termination" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#607d8b;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry x="870" y="298" width="60" height="14" as="geometry"/></mxCell>

        <mxCell id="callout" value="the two terminations are in parallel across the pair → the driver sees a 60 Ω differential load" style="text;html=1;align=center;verticalAlign=middle;fontSize=11.5;fontStyle=2;fontColor=#e65100;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry x="170" y="320" width="600" height="16" as="geometry"/></mxCell>

        <mxCell id="note1" value="▸ Bus, never a star or a ring — every node sees every bit, and sees it at the same time (within the propagation delay)." style="text;html=1;align=left;verticalAlign=middle;fontSize=11.5;fontColor=#37474f;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry x="55" y="355" width="860" height="16" as="geometry"/></mxCell>
        <mxCell id="note2" value="▸ 120 Ω at each physical end matches the twisted pair's characteristic impedance, so an edge is absorbed instead of reflected." style="text;html=1;align=left;verticalAlign=middle;fontSize=11.5;fontColor=#37474f;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry x="55" y="377" width="860" height="16" as="geometry"/></mxCell>
        <mxCell id="note3" value="▸ Stubs stay short (&lt; 0.3 m) — a long stub is an unterminated transmission line hanging off the bus." style="text;html=1;align=left;verticalAlign=middle;fontSize=11.5;fontColor=#37474f;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry x="55" y="399" width="860" height="16" as="geometry"/></mxCell>
        <mxCell id="note4" value="▸ Reach trades against bit rate: ≈ 40 m at 1 Mbit/s, ≈ 500 m at 125 kbit/s, ≈ 1 km at 50 kbit/s." style="text;html=1;align=left;verticalAlign=middle;fontSize=11.5;fontColor=#37474f;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry x="55" y="421" width="860" height="16" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
